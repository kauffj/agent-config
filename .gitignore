# Credentials & secrets
.credentials.json

# Real handwritten signature — forgeable asset, never push (SKILL.md documents restore path)
skills/sign/signature.png

# Session & history data
history.jsonl
session-env/
shell-snapshots/
file-history/
paste-cache/

# Cache & temp
cache/
downloads/
debug/
backups/
telemetry/
mcp-needs-auth-cache.json
image-cache/
.last-cleanup
.last-update-result.json

# Project-specific state (per-repo settings, memory, todos)
projects/
todos/
plans/
tasks/
.workspaces/

# Installed plugins (managed by Claude Code)
plugins/

# Local-only settings (machine-specific permissions)
settings.local.json

# Git internals
.git/
sessions/

# Runtime snapshot written by bin/claude-snapshot (not source)
sessions-snapshot.json
sessions-snapshot.prev.json

# Fleet control plane runtime state (written by hooks, not source)
state/
meta/
fleet/
sound-off
sound-off-*
spawned-windows.log
scheduled.json
scheduled.log

# ── Runtime state that must never reach a public repo ──────────────────
# Claude Code's own config: oauthAccount (email, uuid, org, billing tier),
# userID, machineID, per-project history.
.claude.json
.claude.json.backup

# Background job runner: state, timelines, and COPIED TRANSCRIPTS.
jobs/
daemon/
daemon.lock
daemon.log
daemon.status.json

# Assorted runtime logs & caches written into the repo root.
transcript-shrink.log
gh-pr-status-cache.json

# ── Machine-local, deliberately untracked (present on disk, not shared) ─
# Personal assets. These KEEP WORKING locally; they are simply not
# part of the public repo.
skills/sign/
tools/knowledge-audit-*.md

# Per-piece never-mention sets and any other local-only notes.
*.local.md

__pycache__/
*.pyc
projects-backup/

# Rescue exports (conversation content) + rescue runtime state — never source
rescue/
transcript-check.notified.json
*-remote-session-terminals.txt

# Chrome native-messaging host wrapper — generated per-machine, pins a version path
chrome/

# Other agents' transcript mirrors (claude-transcript-sync)
vendor-backup/
