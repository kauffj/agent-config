{
  "description": "Essential Codex lifecycle, startup, and accidental-safety hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.config/agent-config/lib/doctor.mjs || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/inject-lessons.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/on-pre-tool.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-config/hooks/session-state.sh codex"
          }
        ]
      }
    ]
  }
}
