#!/usr/bin/env python3
"""Snapshot the set of live Claude Code interactive sessions.

Run periodically (systemd-user timer, every 60s). Writes the current live set to
~/.claude/sessions-snapshot.json so that after any shutdown — intentional, battery,
or crash — there is a durable record of which sessions were open, for `claude-resume`
to bring back. The snapshot reflects honest current state (it may be empty if nothing
is running); restore is on-demand, so a stale set is never re-opened uninvited.
"""
import glob
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _claude_sessions_lib import (  # noqa: E402
    CLAUDE_DIR, RECOVERY_SNAP, boot_epoch, live_sessions,
)

OUT = os.path.join(CLAUDE_DIR, "sessions-snapshot.json")
PREV = os.path.join(CLAUDE_DIR, "sessions-snapshot.prev.json")
BOOT_GRACE = 15 * 60  # seconds after boot during which the snapshot may not shrink
CLIFF_MIN_PREV = 3    # only a "cliff" if we previously tracked at least this many
CLIFF_DROP = 3        # ...and lost at least this many between two 60s ticks
RECOVERY_TTL = 12 * 60 * 60  # don't downgrade a recovery point newer than this


def _read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _atomic_write(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _restorable_ids():
    """Session ids `claude-resume` could still bring back: the current snapshot
    plus a fresh recovery point (the same sources as resume_set(), minus its
    liveness/transcript filtering, which doesn't matter for reaping)."""
    ids = set()
    for path, ttl in ((OUT, None), (RECOVERY_SNAP, RECOVERY_TTL)):
        d = _read(path) or {}
        if ttl is not None and (time.time() - d.get("preservedAt", 0)) > ttl:
            continue
        for s in d.get("sessions", []):
            if s.get("sessionId"):
                ids.add(s["sessionId"])
    return ids


SESSION_ID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)


def _reap_dead_state(live_ids, keep_ids=frozenset()):
    """Piggyback dead-session-state cleanup on this 60s timer. A state file at
    ~/.claude/state/<session_id>.json is garbage once its session is neither
    live nor still restorable (keep_ids: the snapshot/recovery set that
    claude-resume reads) — it otherwise skews the fleet tab bar's wait gradient
    and collides with reused WezTerm pane ids. Liveness alone is the wrong
    signal in the post-crash window: after the 2026-07-10 overheat reboot, the
    first hand-opened session made live_ids non-empty and the reap deleted the
    15 pre-crash state files one tick before claude-resume ran, so every
    resumed session restarted its `since` — wiping the idleness history the
    files had carried through the crash. Sparing restorable ids rides on the
    boot-grace and cliff guards below, which keep exactly those sessions in
    the snapshot/recovery files until they're brought back (or age out). A
    session that reappears regenerates its file on the next hook, so an
    over-eager reap self-heals — but only its `status`, not its wait history.
    Guarded, and never mass-deletes on an empty/failed liveness read, so it
    can't disturb the snapshot below."""
    if not live_ids:
        return
    keep = set(live_ids) | set(keep_ids)
    try:
        for f in glob.glob(os.path.join(CLAUDE_DIR, "state", "*.json")):
            name = os.path.basename(f)[:-5]
            if not SESSION_ID_RE.match(name):
                continue   # not ours: state/ also holds other tools' runtime
                           # files (claude-acct's usage cache lived here and
                           # was being reaped every tick, 2026-08-19)
            if name not in keep:
                try:
                    os.remove(f)
                except OSError:
                    pass
    except Exception:
        pass


def _reopen_due():
    """Piggyback scheduled-reopen on this 60s timer (see bin/claude-schedule): a
    snoozed session whose reopen_at has passed is spawned back as a WezTerm tab.
    Best-effort and self-contained (claude-schedule keeps entries whose spawn
    fails, e.g. WezTerm not up), so it can never affect the snapshot below."""
    script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "claude-schedule")
    try:
        r = subprocess.run([script, "reopen-due"], timeout=20, capture_output=True, text=True)
        if r.returncode != 0 or r.stderr.strip():
            raise RuntimeError("rc=%s err=%s" % (r.returncode, r.stderr.strip()[:300]))
    except Exception as e:
        # Log rather than swallow — a silent failure here (e.g. a missing import)
        # is exactly what let scheduled reopens quietly do nothing for a while.
        try:
            with open(os.path.join(CLAUDE_DIR, "scheduled.log"), "a") as f:
                f.write("%s  _reopen_due FAILED: %r\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), e))
        except Exception:
            pass


def main():
    live = live_sessions()
    _reap_dead_state(set(live), _restorable_ids())
    _reopen_due()

    sessions = sorted(
        live.values(),
        key=lambda s: (s.get("cwd") or "", s["sessionId"]),
    )
    data = {"capturedAt": int(time.time()), "sessions": sessions}

    existing = _read(OUT) or {}
    prev_count = len(existing.get("sessions", []))
    cur_count = len(sessions)

    # Cliff guard. A freeze/crash/X-restart kills many sessions at once, between
    # two ticks — unlike closing tabs one at a time. The boot-grace guard below
    # only covers a real *reboot*; a suspend-resume freeze leaves boot time
    # untouched, so without this the very next tick overwrites the pre-freeze
    # snapshot (it did, on 2026-06-30 — cost a session). On a cliff, copy the
    # pre-cliff set into a recovery file the timer never clobbers, so an
    # on-demand resume still finds the sessions that died. The honest snapshot
    # below still updates; restore is on-demand, so a stale recovery point is
    # never reopened uninvited and is consumed (archived) on the next restore.
    if prev_count >= CLIFF_MIN_PREV and (prev_count - cur_count) >= CLIFF_DROP:
        rec = _read(RECOVERY_SNAP) or {}
        rec_count = len(rec.get("sessions", []))
        rec_age = int(time.time()) - rec.get("preservedAt", 0)
        if prev_count > rec_count or rec_age > RECOVERY_TTL:
            _atomic_write(RECOVERY_SNAP, {
                "capturedAt": existing.get("capturedAt", int(time.time())),
                "preservedAt": int(time.time()),
                "sessions": existing.get("sessions", []),
            })
            if "-v" in sys.argv or "--verbose" in sys.argv:
                print(f"cliff: preserved {prev_count} pre-crash session(s) "
                      f"-> {RECOVERY_SNAP}")

    # Crash recovery hinges on the pre-shutdown snapshot surviving the reboot.
    # Right after boot, sessions haven't been reopened yet, so a plain overwrite
    # would replace the real set with a near-empty one (and rotate away .prev
    # too). For the first BOOT_GRACE seconds, refuse to let the snapshot shrink;
    # it grows back to honest state as sessions are restored. Safe because
    # restore is on-demand — a preserved larger set is never reopened uninvited.
    btime = boot_epoch()
    if (btime is not None and (int(time.time()) - btime) < BOOT_GRACE
            and cur_count < prev_count):
        if "-v" in sys.argv or "--verbose" in sys.argv:
            print(f"boot grace: keeping existing snapshot "
                  f"({prev_count} session(s)) over current {cur_count}")
        return

    if os.path.exists(OUT):
        try:
            os.replace(OUT, PREV)
        except OSError:
            pass
    _atomic_write(OUT, data)

    if "-v" in sys.argv or "--verbose" in sys.argv:
        print(f"captured {len(sessions)} session(s) -> {OUT}")
        for s in sessions:
            print(f"  {s['sessionId'][:8]}  {s.get('cwd')}  [{s['source']}]")


if __name__ == "__main__":
    main()
