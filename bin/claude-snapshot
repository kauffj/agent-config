#!/usr/bin/env python3
"""Snapshot the set of live Claude Code interactive sessions.

Run periodically (systemd-user timer, every 60s). Writes the current live set to
~/.claude/sessions-snapshot.json so that after any shutdown — intentional, battery,
or crash — there is a durable record of which sessions were open, for `claude-resume`
to bring back. The snapshot reflects honest current state (it may be empty if nothing
is running); restore is on-demand, so a stale set is never re-opened uninvited.
"""
import glob
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _claude_sessions_lib import (  # noqa: E402
    CLAUDE_DIR, RECOVERY_SNAP, boot_epoch, live_sessions,
)

OUT = os.path.join(CLAUDE_DIR, "sessions-snapshot.json")
PREV = os.path.join(CLAUDE_DIR, "sessions-snapshot.prev.json")
BOOT_GRACE = 15 * 60  # seconds after boot during which the snapshot may not shrink
CLIFF_MIN_PREV = 3    # only a "cliff" if we previously tracked at least this many
CLIFF_DROP = 3        # ...and lost at least this many between two 60s ticks
RECOVERY_TTL = 12 * 60 * 60  # don't downgrade a recovery point newer than this


def _read(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def _atomic_write(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _reap_dead_state(live_ids):
    """Piggyback dead-session-state cleanup on this 60s timer. A state file at
    ~/.claude/state/<session_id>.json is garbage once its session is no longer
    live — it otherwise skews the fleet tab bar's wait gradient and collides with
    reused WezTerm pane ids. Session liveness (not pane liveness) is the right
    signal: it catches orphans that never recorded a pane too. A session that
    reappears regenerates its file on the next hook, so an over-eager reap
    self-heals. Guarded, and never mass-deletes on an empty/failed liveness read,
    so it can't disturb the snapshot below."""
    if not live_ids:
        return
    try:
        for f in glob.glob(os.path.join(CLAUDE_DIR, "state", "*.json")):
            if os.path.basename(f)[:-5] not in live_ids:
                try:
                    os.remove(f)
                except OSError:
                    pass
    except Exception:
        pass


def main():
    live = live_sessions()
    _reap_dead_state(set(live))

    sessions = sorted(
        live.values(),
        key=lambda s: (s.get("cwd") or "", s["sessionId"]),
    )
    data = {"capturedAt": int(time.time()), "sessions": sessions}

    existing = _read(OUT) or {}
    prev_count = len(existing.get("sessions", []))
    cur_count = len(sessions)

    # Cliff guard. A freeze/crash/X-restart kills many sessions at once, between
    # two ticks — unlike closing tabs one at a time. The boot-grace guard below
    # only covers a real *reboot*; a suspend-resume freeze leaves boot time
    # untouched, so without this the very next tick overwrites the pre-freeze
    # snapshot (it did, on 2026-06-30 — cost a session). On a cliff, copy the
    # pre-cliff set into a recovery file the timer never clobbers, so an
    # on-demand resume still finds the sessions that died. The honest snapshot
    # below still updates; restore is on-demand, so a stale recovery point is
    # never reopened uninvited and is consumed (archived) on the next restore.
    if prev_count >= CLIFF_MIN_PREV and (prev_count - cur_count) >= CLIFF_DROP:
        rec = _read(RECOVERY_SNAP) or {}
        rec_count = len(rec.get("sessions", []))
        rec_age = int(time.time()) - rec.get("preservedAt", 0)
        if prev_count > rec_count or rec_age > RECOVERY_TTL:
            _atomic_write(RECOVERY_SNAP, {
                "capturedAt": existing.get("capturedAt", int(time.time())),
                "preservedAt": int(time.time()),
                "sessions": existing.get("sessions", []),
            })
            if "-v" in sys.argv or "--verbose" in sys.argv:
                print(f"cliff: preserved {prev_count} pre-crash session(s) "
                      f"-> {RECOVERY_SNAP}")

    # Crash recovery hinges on the pre-shutdown snapshot surviving the reboot.
    # Right after boot, sessions haven't been reopened yet, so a plain overwrite
    # would replace the real set with a near-empty one (and rotate away .prev
    # too). For the first BOOT_GRACE seconds, refuse to let the snapshot shrink;
    # it grows back to honest state as sessions are restored. Safe because
    # restore is on-demand — a preserved larger set is never reopened uninvited.
    btime = boot_epoch()
    if (btime is not None and (int(time.time()) - btime) < BOOT_GRACE
            and cur_count < prev_count):
        if "-v" in sys.argv or "--verbose" in sys.argv:
            print(f"boot grace: keeping existing snapshot "
                  f"({prev_count} session(s)) over current {cur_count}")
        return

    if os.path.exists(OUT):
        try:
            os.replace(OUT, PREV)
        except OSError:
            pass
    _atomic_write(OUT, data)

    if "-v" in sys.argv or "--verbose" in sys.argv:
        print(f"captured {len(sessions)} session(s) -> {OUT}")
        for s in sessions:
            print(f"  {s['sessionId'][:8]}  {s.get('cwd')}  [{s['source']}]")


if __name__ == "__main__":
    main()
