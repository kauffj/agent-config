#!/usr/bin/env bash
# Run one agent command in a clean login environment, then leave a clean shell.
#
# WezTerm creates tabs on behalf of whichever pane asked. That client process
# can be a Claude session bound to an alternate account, or another harness
# carrying its own config, auth, and session state. Inheriting those values
# makes a resumed Codex tab look like that Claude process and, after the agent
# exits, pins the shell's next `claude` launch to CLAUDE_CONFIG_DIR instead of
# the account router.

set -u

session_id=
wait_session=false
while [[ $# -gt 1 ]]; do
    case "$1" in
        --session)
            [[ $# -ge 3 ]] || break
            session_id=$2
            shift 2
            ;;
        --wait-session)
            wait_session=true
            shift
            ;;
        *) break ;;
    esac
done

if [[ $# -ne 1 || -z "$1" ]]; then
    echo "usage: agent-tab-shell [--session SID] [--wait-session] '<agent command>'" >&2
    exit 2
fi
if [[ -n "$session_id" && ! "$session_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]; then
    echo "agent-tab-shell: unsafe session id" >&2
    exit 2
fi
if [[ "$wait_session" == true && -z "$session_id" ]]; then
    echo "agent-tab-shell: --wait-session requires --session" >&2
    exit 2
fi

clean_agent_identity() {
    # BROWSER is account-specific only when claude-acct installed the matching
    # profile binding. Preserve an unrelated user-selected browser.
    if [[ -n "${CLAUDE_ACCT_BROWSER_PROFILE:-}" \
          && "${BROWSER:-}" == *claude-acct-browser ]]; then
        unset BROWSER
    fi
    unset CLAUDE_CONFIG_DIR CLAUDE_ACCT CLAUDE_ACCT_BROWSER_PROFILE
    unset CLAUDECODE CLAUDE_PID
    unset CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID
    unset CLAUDE_CODE_BRIDGE_SESSION_ID CLAUDE_CODE_ENTRYPOINT
    unset CLAUDE_CODE_EXECPATH CLAUDE_CODE_MESSAGING_SOCKET
    unset CLAUDE_CODE_MESSAGING_TOKEN
    unset CODEX_SESSION_ID CODEX_THREAD_ID CODEX_CI
    unset CODEX_HOME CODEX_SQLITE_HOME CODEX_API_KEY CODEX_ACCESS_TOKEN
    unset OPENAI_FEDERATION_RULE_ID OPENAI_IDENTITY_TOKEN_FILE
    unset OPENAI_WORKLOAD_IDENTITY_CONTEXT
    unset CODEX_MANAGED_BY_NPM CODEX_MANAGED_PACKAGE_ROOT
}

command=$1
clean_agent_identity

if [[ -n "$session_id" ]]; then
    helper="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_agent_session_lease.py"
    helper_args=()
    if [[ "$wait_session" == true ]]; then
        echo "agent-tab-shell: waiting for session $session_id to exit"
        helper_args+=(--wait)
    fi
    "$helper" "${helper_args[@]}" "$session_id" "$command"
    status=$?
    # Acquisition collisions are helper control flow, not completed agent
    # sessions. Do not turn a rejected duplicate into a stray interactive tab.
    if [[ $status -eq 75 && -t 0 && -t 1 ]]; then
        exit 75
    fi
    if [[ $status -ne 0 && -t 0 && -t 1 ]]; then
        # An uncatchable supervisor death can leave the agent group in the
        # foreground. Its inherited lease tells recovery exactly when that tree
        # is gone; only then reclaim the TTY for the post-agent shell.
        "$helper" --recover-terminal "$session_id" || true
    fi
else
    # A login + interactive shell reconstructs PATH and shell functions exactly
    # as a terminal launch does (`claude` is the account-routing shell function).
    bash -lic "$command"
    status=$?
fi

# The returned shell is intentionally not an agent. The helper owns and releases
# the lease before control returns here. The agent process tree inherits the
# lease only so an unexpected supervisor death cannot leave a writer unlocked.
clean_agent_identity
if [[ -t 0 && -t 1 ]]; then
    exec bash -l
fi
exit "$status"
