#!/usr/bin/env python3
"""Snooze an agent session: close its tab now, reopen it at a scheduled time.

Owns ~/.claude/scheduled.json — a list of {session_id, vendor, cwd, reopen_at,
label, created_at}. "Snooze" is just a scheduled resurrection: the tab is
closed (the transcript survives via the durability layer), and `reopen-due` —
driven every 60s by the claude-snapshot timer — spawns that vendor's native
resume command when the time arrives. Robust to suspend/reboot: an overdue
reopen fires on the next tick once the machine and WezTerm are back.

  claude-schedule add --sid SID --vendor V --cwd CWD --when "STR" [--label L]
  claude-schedule list [--json]
  claude-schedule cancel --sid SID
  claude-schedule reopen-due [--dry-run]

Time STR accepts: relative (2h, 30m, 3d, 1w, "3 days"), tomorrow, a weekday
name ("monday", "next fri") — each with an optional part of day and/or time
("monday morning at 9 am", "tomorrow evening") — tonight, next week, a bare
time of day (9am, 14:00 -> next occurrence), or ISO (YYYY-MM-DD [HH:MM]).
Anything else falls back to a headless `claude -p` call (validated, future-
only), so free-form phrasing still works when the grammar misses.
"""
import argparse
from contextlib import contextmanager
import datetime as dt
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _claude_sessions_lib import (  # noqa: E402
    AGENT_STATE_DIR, CLAUDE_DIR, native_live_session_ids, resume_command,
)

SCHEDULED = os.path.join(CLAUDE_DIR, "scheduled.json")
SCHEDULE_LOCK = os.path.join(AGENT_STATE_DIR, "scheduled.lock")

_UNITS = {
    "s": 1, "sec": 1, "secs": 1, "second": 1, "seconds": 1,
    "m": 60, "min": 60, "mins": 60, "minute": 60, "minutes": 60,
    "h": 3600, "hr": 3600, "hrs": 3600, "hour": 3600, "hours": 3600,
    "d": 86400, "day": 86400, "days": 86400,
    "w": 604800, "wk": 604800, "week": 604800, "weeks": 604800,
}


def _parse_tod(s):
    """'9am' / '9:30pm' / '14:00' / '9' -> (hour, minute). ValueError if not a time."""
    s = s.strip().lower()
    ampm = None
    if s.endswith(("am", "pm")):
        ampm, s = s[-2:], s[:-2].strip()
    hh, _, mm = s.partition(":")
    mm = mm or "0"
    if not (hh.isdigit() and mm.isdigit()):
        raise ValueError("bad time %r" % s)
    h, m = int(hh), int(mm)
    if ampm == "pm" and h < 12:
        h += 12
    if ampm == "am" and h == 12:
        h = 0
    if not (0 <= h <= 23 and 0 <= m <= 59):
        raise ValueError("time out of range")
    return h, m


_WEEKDAYS = {
    "monday": 0, "mon": 0, "tuesday": 1, "tue": 1, "tues": 1,
    "wednesday": 2, "wed": 2, "thursday": 3, "thu": 3, "thur": 3, "thurs": 3,
    "friday": 4, "fri": 4, "saturday": 5, "sat": 5, "sunday": 6, "sun": 6,
}
_PARTS_OF_DAY = {
    "morning": (9, 0), "noon": (12, 0), "midday": (12, 0),
    "afternoon": (14, 0), "evening": (18, 0), "night": (20, 0),
}


def _tod_from_tokens(tokens):
    """Tokens after a day word -> (hour, minute) or None if there are none.
    Drops 'at'/'on' filler; a part-of-day word supplies the time only when no
    explicit one is given ("monday morning at 9 am" -> 9:00). ValueError if
    what remains isn't a time."""
    explicit, default = [], None
    for t in tokens:
        if t in ("at", "on"):
            continue
        if t in _PARTS_OF_DAY:
            default = _PARTS_OF_DAY[t]
        else:
            explicit.append(t)
    if explicit:
        return _parse_tod(" ".join(explicit))
    return default


def parse_when(s, now=None):
    """A human time expression -> absolute epoch (int)."""
    now = now or dt.datetime.now()
    s = " ".join(s.strip().lower().split())

    mobj = re.fullmatch(r"(\d+)\s*([a-z]+)", s)
    if mobj and mobj.group(2) in _UNITS:
        return int(now.timestamp() + int(mobj.group(1)) * _UNITS[mobj.group(2)])

    if s == "tonight":
        cand = now.replace(hour=20, minute=0, second=0, microsecond=0)
        if cand <= now:
            cand += dt.timedelta(days=1)
        return int(cand.timestamp())

    if s == "next week":
        return int((now + dt.timedelta(days=7)).timestamp())

    # tomorrow / weekday, with optional part of day and/or explicit time:
    # "tomorrow", "tomorrow evening", "monday morning at 9 am", "next fri 14:00"
    tokens = s.split()
    nxt = tokens[0] == "next" and len(tokens) > 1
    day = tokens[1] if nxt else tokens[0]
    if day == "tomorrow" or day in _WEEKDAYS:
        h, m = _tod_from_tokens(tokens[(2 if nxt else 1):]) or (9, 0)
        if day == "tomorrow":
            cand = now + dt.timedelta(days=1)
        else:
            ahead = (_WEEKDAYS[day] - now.weekday()) % 7
            if nxt and ahead == 0:
                ahead = 7
            cand = now + dt.timedelta(days=ahead)
        cand = cand.replace(hour=h, minute=m, second=0, microsecond=0)
        if cand <= now:                      # today's weekday, time already past
            cand += dt.timedelta(days=7)
        return int(cand.timestamp())

    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return int(dt.datetime.strptime(s, fmt).timestamp())
        except ValueError:
            pass

    try:
        h, m = _parse_tod(s)
        cand = now.replace(hour=h, minute=m, second=0, microsecond=0)
        if cand <= now:
            cand += dt.timedelta(days=1)
        return int(cand.timestamp())
    except ValueError:
        pass

    raise ValueError("could not parse time: %r" % s)


def _read():
    try:
        with open(SCHEDULED) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except (OSError, ValueError):
        return []


def _write(entries):
    os.makedirs(CLAUDE_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".scheduled-", dir=CLAUDE_DIR)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(entries, stream, indent=2)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, SCHEDULED)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


@contextmanager
def _schedule_lock():
    """Serialize every scheduled.json read/modify/write transition."""
    os.makedirs(os.path.dirname(SCHEDULE_LOCK), mode=0o700, exist_ok=True)
    fd = os.open(SCHEDULE_LOCK,
                 os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
                 0o600)
    try:
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _wakes_in(reopen_at, now):
    d = int(reopen_at - now)
    if d <= 0:
        return "due"
    if d < 3600:
        return "%dm" % max(1, round(d / 60))
    if d < 86400:
        return "%dh" % round(d / 3600)
    return "%dd" % round(d / 86400)


def _llm_when(s, now):
    """Fallback for phrases the grammar can't parse: ask a headless claude
    (haiku — this path is rare and interactive, so speed beats depth) to
    resolve the phrase against the current clock. Strictly validated: the
    reply must be a lone parseable 'YYYY-MM-DD HH:MM' in the future, so a
    hallucinated answer degrades to the normal parse error rather than a
    silently wrong schedule — and the caller echoes the resolved time back
    for eyeball verification. None on any failure (no CLI, offline, timeout,
    bad reply); only `add` calls this, so the 60s reopen timer never blocks
    on the network."""
    if not shutil.which("claude"):
        return None
    prompt = (
        "Current local time: %s (%s).\n"
        "A user wants a terminal tab to reopen at: %r\n"
        "Resolve that to an absolute local time; if ambiguous, pick the next "
        "future occurrence. Reply with exactly one line and nothing else: "
        "'YYYY-MM-DD HH:MM', or 'none' if it does not describe a time."
        % (now.strftime("%Y-%m-%d %H:%M"), now.strftime("%A"), s))
    try:
        # --strict-mcp-config: don't boot MCP servers for a one-line answer
        # (drops the call from ~9s to ~3s; wezterm blocks on this synchronously).
        r = subprocess.run(["claude", "-p", prompt, "--model", "haiku",
                            "--strict-mcp-config"],
                           capture_output=True, text=True, timeout=30)
        cand = (r.stdout or "").strip().splitlines()[-1].strip()
        t = dt.datetime.strptime(cand, "%Y-%m-%d %H:%M")
        return int(t.timestamp()) if t > now else None
    except Exception:
        return None


def cmd_add(a):
    # One clean line on a bad time, not a traceback — stderr lands verbatim in
    # the WezTerm snooze toast, which only has room for the first line.
    try:
        when = parse_when(a.when)
    except ValueError as e:
        when = _llm_when(a.when, dt.datetime.now())
        if when is None:
            sys.exit("error: %s — try '2h', 'tomorrow 9am', 'monday morning', "
                     "'2026-07-14 09:00'" % e)
    with _schedule_lock():
        entries = [e for e in _read() if e.get("session_id") != a.sid]
        entries.append({
            "session_id": a.sid,
            "vendor": a.vendor,
            "cwd": a.cwd,
            "reopen_at": when,
            "label": a.label or a.sid[:8],
            "created_at": int(dt.datetime.now().timestamp()),
        })
        _write(entries)
    print("scheduled %s -> %s" % (a.sid[:8], dt.datetime.fromtimestamp(when).strftime("%Y-%m-%d %H:%M")))


def cmd_cancel(a):
    with _schedule_lock():
        entries = _read()
        kept = [e for e in entries if e.get("session_id") != a.sid]
        _write(kept)
    print("cancelled %s" % a.sid[:8] if len(kept) != len(entries) else "no schedule for %s" % a.sid[:8])


def cmd_list(a):
    now = dt.datetime.now().timestamp()
    entries = sorted(_read(), key=lambda e: e.get("reopen_at", 0))
    if a.json:
        for e in entries:
            e["wakes_in"] = _wakes_in(e.get("reopen_at", 0), now)
            e["resume_command"] = resume_command(
                e.get("session_id"), e.get("vendor") or "claude")
        print(json.dumps(entries))
        return
    if not entries:
        print("no scheduled sessions")
        return
    for e in entries:
        print("%5s  %-24s  %s" % (
            _wakes_in(e.get("reopen_at", 0), now), e.get("label", ""),
            dt.datetime.fromtimestamp(e.get("reopen_at", 0)).strftime("%Y-%m-%d %H:%M")))


def _target_window():
    """The WezTerm window to spawn reopened tabs into. Needed because this runs
    headless from the snapshot timer (no $WEZTERM_PANE), and `wezterm cli spawn`
    refuses without a pane/window to target. Pick the window with the most tabs —
    the fleet window. None if WezTerm isn't reachable."""
    try:
        out = subprocess.run(["wezterm", "cli", "list", "--format", "json"],
                             capture_output=True, text=True, timeout=3)
        if out.returncode != 0:
            return None
        counts = {}
        for p in json.loads(out.stdout):
            wid = p.get("window_id")
            if wid is not None:
                counts[wid] = counts.get(wid, 0) + 1
        return max(counts, key=counts.get) if counts else None
    except Exception:
        return None


def _log(msg):
    try:
        with open(os.path.join(CLAUDE_DIR, "scheduled.log"), "a") as f:
            f.write("%s  %s\n" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), msg))
    except Exception:
        pass


def _reopen(a, force_sid=None):
    now = dt.datetime.now().timestamp()
    entries = _read()
    if not entries:
        return False
    have_wezterm = shutil.which("wezterm") is not None
    requested_window = getattr(a, "window_id", None)
    win = requested_window if have_wezterm and requested_window is not None \
        else (_target_window() if have_wezterm else None)
    # A lease proves only that a launch is in flight. Drop durable snooze state
    # only for a native process that is observably running on the host.
    try:
        live = native_live_session_ids()
    except OSError as exc:
        _log("REOPEN REFUSED cannot inspect Codex writer locks: %s" % exc)
        return False
    kept, requested, reopened, settled, dropped, failed = [], [], [], set(), 0, 0
    tab_shell = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                             "agent-tab-shell")
    for e in entries:
        sid, cwd = e.get("session_id"), e.get("cwd") or ""
        command = resume_command(sid, e.get("vendor") or "claude") if sid else None
        selected = force_sid is not None and sid == force_sid
        if not sid or (not selected and e.get("reopen_at", 0) > now):
            kept.append(e)
            continue
        if force_sid is not None and not selected:
            kept.append(e)
            continue
        if command is None:
            kept.append(e)
            failed += 1
            _log("REOPEN REFUSED %s unknown vendor=%s"
                 % (sid[:8], e.get("vendor")))
            continue
        if sid in live:                      # already back (manual reopen) — drop it
            settled.add(sid)
            dropped += 1
            continue
        if a.dry_run:
            print("would reopen %s  %s" % (sid[:8], cwd))
            kept.append(e)
            continue
        if not have_wezterm or win is None:  # WezTerm down / unreachable — retry next tick
            kept.append(e)
            continue
        try:
            r = subprocess.run(
                ["wezterm", "cli", "spawn", "--window-id", str(win),
                 "--cwd", cwd, "--", tab_shell, "--session", sid, command],
                capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError) as exc:
            kept.append(e)
            failed += 1
            _log("SPAWN FAILED %s win=%s err=%s"
                 % (sid[:8], win, str(exc)[:200]))
            continue
        if r.returncode == 0:
            requested.append(e)
        else:
            kept.append(e)                   # keep on failure (mirror claude-resume)
            failed += 1
            _log("SPAWN FAILED %s rc=%s win=%s err=%s" % (sid[:8], r.returncode, win, r.stderr.strip()[:200]))
    # A successful mux RPC proves only that a pane was allocated. Wait briefly
    # for the native agent process before removing durable snooze state;
    # an unconfirmed request stays queued and safely retries on a later tick.
    if requested:
        deadline = time.monotonic() + 5
        started = set()
        wanted = {e["session_id"] for e in requested}
        while time.monotonic() < deadline:
            try:
                started = native_live_session_ids()
            except OSError as exc:
                _log("STARTUP CHECK FAILED err=%s; keeping scheduled entries"
                     % str(exc)[:200])
                break
            if wanted.issubset(started):
                break
            time.sleep(0.5)
        for e in requested:
            sid = e["session_id"]
            if sid in started:
                reopened.append(e)
                settled.add(sid)
                _log("reopened %s (%s) win=%s"
                     % (sid[:8], e.get("label", ""), win))
            else:
                kept.append(e)
                failed += 1
                _log("STARTUP UNCONFIRMED %s win=%s; keeping scheduled entry"
                     % (sid[:8], win))
    if not a.dry_run and (reopened or dropped or failed):
        _log("run: entries=%d due-reopened=%d dropped-live=%d failed=%d wezterm=%s win=%s"
             % (len(entries), len(reopened), dropped, failed, have_wezterm, win))
    if len(kept) != len(entries):            # persist any change: reopened OR dropped-live
        _write(kept)
    for e in reopened:
        _notify(e.get("label", "a session"))
    return force_sid in settled if force_sid is not None else bool(reopened)


def cmd_reopen_due(a):
    # Holding this lock across the bounded startup confirmation prevents an add
    # or cancel from being overwritten by the older snapshot of scheduled.json.
    with _schedule_lock():
        _reopen(a)


def cmd_reopen(a):
    with _schedule_lock():
        found = any(e.get("session_id") == a.sid for e in _read())
        if not found:
            sys.exit("no schedule for %s" % a.sid[:8])
        if not _reopen(a, force_sid=a.sid):
            sys.exit("session %s did not start; schedule preserved" % a.sid[:8])


def _notify(label):
    if shutil.which("notify-send"):
        try:
            subprocess.run(["notify-send", "Agent tab reopened", "%s is back" % label],
                           check=False, timeout=3)
        except Exception:
            pass


def main():
    p = argparse.ArgumentParser(prog="claude-schedule")
    sub = p.add_subparsers(dest="cmd", required=True)

    pa = sub.add_parser("add"); pa.set_defaults(fn=cmd_add)
    pa.add_argument("--sid", required=True)
    pa.add_argument("--vendor", default="claude")
    pa.add_argument("--cwd", required=True)
    pa.add_argument("--when", required=True)
    pa.add_argument("--label", default="")

    pc = sub.add_parser("cancel"); pc.set_defaults(fn=cmd_cancel)
    pc.add_argument("--sid", required=True)

    pl = sub.add_parser("list"); pl.set_defaults(fn=cmd_list)
    pl.add_argument("--json", action="store_true")

    pr = sub.add_parser("reopen-due"); pr.set_defaults(fn=cmd_reopen_due)
    pr.add_argument("--dry-run", action="store_true")

    po = sub.add_parser("reopen"); po.set_defaults(fn=cmd_reopen, dry_run=False)
    po.add_argument("--sid", required=True)
    po.add_argument("--window-id")

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
