#!/usr/bin/env python3
"""Reopen the Claude Code sessions that were live at the last snapshot.

Reads ~/.claude/sessions-snapshot.json (written by `claude-snapshot`), skips any
session already running, groups the rest by working directory, and opens one tilix
window per project with each session as a tab running `claude --resume <id>`.

Usage:
  claude-resume-all              # restore, one window per project
  claude-resume-all --single-window
  claude-resume-all --dry-run    # show what would open, launch nothing
  claude-resume-all --yes        # skip the confirmation prompt for large restores
  claude-resume-all --snapshot PATH   # restore from a specific snapshot (e.g. the .prev backup)
  claude-resume-all --from-transcripts [N]   # ignore the snapshot; reconstruct the
                                             # N (default 12) most-recently-active
                                             # sessions from transcript files
"""
import glob
import json
import os
import shlex
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _claude_sessions_lib import (  # noqa: E402
    CLAUDE_DIR, clear_recovery, live_sessions, recent_transcript_sessions,
    resume_set,
)

SNAP = os.path.join(CLAUDE_DIR, "sessions-snapshot.json")
CONFIRM_OVER = 10      # prompt before opening more than this many tabs
STARTUP_TIMEOUT = 15   # seconds to wait for a launched session to actually come up
POLL = 0.6             # seconds between liveness polls


def load_snapshot(path):
    try:
        with open(path) as f:
            return json.load(f).get("sessions", [])
    except FileNotFoundError:
        sys.exit(f"No snapshot at {path}. Is the claude-snapshot timer running?")
    except (OSError, ValueError) as e:
        sys.exit(f"Could not read {path}: {e}")


def tilix_cmd(cwd, sid, new_window):
    inner = (
        f"cd {shlex.quote(cwd)} && claude --resume {shlex.quote(sid)}; "
        "echo; echo '[claude exited — tab kept open]'; exec bash"
    )
    base = ["tilix"] if new_window else ["tilix", "-a", "app-new-session"]
    return base + ["--working-directory", cwd, "-e", "bash", "-lic", inner]


def sid_running(sid):
    """True once a live `claude` process carries this session id in its argv.
    Our launch runs `claude --resume <sid>`, so the id shows up in /proc almost
    as soon as the process execs — a direct readiness+success signal, far more
    reliable than a fixed sleep."""
    for pdir in glob.glob("/proc/[0-9]*"):
        try:
            with open(os.path.join(pdir, "cmdline"), "rb") as f:
                parts = [p.decode("utf-8", "replace") for p in f.read().split(b"\0") if p]
        except OSError:
            continue
        if not parts or os.path.basename(parts[0]) != "claude":
            continue
        if sid in parts:
            return True
    return False


def wait_running(sid, timeout=STARTUP_TIMEOUT):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if sid_running(sid):
            return True
        time.sleep(POLL)
    return False


def main():
    argv = sys.argv[1:]
    args = set(argv)
    dry = "--dry-run" in args
    single = "--single-window" in args
    assume_yes = "--yes" in args or "-y" in args
    snap_path = SNAP
    if "--snapshot" in argv:
        i = argv.index("--snapshot")
        if i + 1 >= len(argv):
            sys.exit("--snapshot requires a path")
        snap_path = argv[i + 1]

    live = set(live_sessions())

    if "--from-transcripts" in argv:
        i = argv.index("--from-transcripts")
        limit = 12
        if i + 1 < len(argv) and argv[i + 1].isdigit():
            limit = int(argv[i + 1])
        # Pull extra, then exclude live ones, so the live session(s) don't
        # crowd out genuine candidates from the N most-recent slots.
        sessions = recent_transcript_sessions(limit=limit + len(live) + 4,
                                              exclude=live)[:limit]
    elif "--snapshot" in argv:
        sessions = load_snapshot(snap_path)
    else:
        # Default: snapshot ∪ pre-crash recovery set, dead transcripts dropped.
        sessions = resume_set()

    todo, skipped = [], 0
    for s in sessions:
        sid, cwd = s.get("sessionId"), s.get("cwd")
        if not sid or not cwd or not os.path.isdir(cwd):
            continue
        if sid in live:
            skipped += 1
            continue
        todo.append((cwd, sid))

    if not todo:
        print(f"Nothing to restore ({len(sessions)} in snapshot, {skipped} already running).")
        return

    # Group by cwd, preserving first-appearance order.
    groups, order = {}, []
    for cwd, sid in todo:
        if cwd not in groups:
            groups[cwd] = []
            order.append(cwd)
        groups[cwd].append(sid)
    if single:
        groups, order = {"__all__": [sid for _, sid in todo]}, ["__all__"]

    n = len(todo)
    print(f"Restoring {n} session(s) across {len(order)} window(s)"
          + (f"; skipping {skipped} already running." if skipped else "."))
    for cwd in order:
        label = cwd if cwd != "__all__" else "(single window, all tabs)"
        print(f"  {label}: {len(groups[cwd])} tab(s)")

    if dry:
        print("(dry run — nothing launched)")
        return
    if n > CONFIRM_OVER and not assume_yes and sys.stdin.isatty():
        if input(f"Open {n} tabs? [y/N] ").strip().lower() not in ("y", "yes"):
            print("Aborted.")
            return

    # Build (cwd, sid, new_window) launches. Each tab cd's to its own cwd.
    # Single-window: only the first launch opens a window. Per-project: the first
    # launch of each group opens that group's window (app-new-session fills the rest).
    launches = []
    if single:
        launches = [(cwd, sid, i == 0) for i, (cwd, sid) in enumerate(todo)]
    else:
        for cwd in order:
            for j, sid in enumerate(groups[cwd]):
                launches.append((cwd, sid, j == 0))

    def launch(cwd, sid, new_window):
        subprocess.Popen(
            tilix_cmd(cwd, sid, new_window),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    # Launch sequentially, confirming each session is actually up before the next.
    # This both paces correctly (the tilix server is guaranteed ready before we
    # attach the next tab to it — the old blind sleep raced and dropped tabs) and
    # lets us retry + report genuine failures instead of firing and hoping.
    opened, failed = [], []
    for cwd, sid, new_window in launches:
        launch(cwd, sid, new_window)
        if wait_running(sid):
            opened.append(sid)
            continue
        # Lost the race or crashed on start — retry once as its own fresh window
        # (an extra window beats a missing session).
        launch(cwd, sid, True)
        if wait_running(sid):
            opened.append(sid)
        else:
            failed.append((cwd, sid))

    print(f"Opened {len(opened)}/{len(launches)} session(s).")
    if failed:
        print(f"Could not open {len(failed)} — resume manually:")
        for cwd, sid in failed:
            print(f"  (cd {shlex.quote(cwd)} && claude --resume {sid})")

    # Consume the recovery point once everything's back (skip if any failed, so a
    # retry can still see it). Only for the default source — explicit --snapshot/
    # --from-transcripts runs aren't the post-crash restore the recovery file is for.
    if not failed and not dry and "--snapshot" not in argv \
            and "--from-transcripts" not in argv:
        clear_recovery()


if __name__ == "__main__":
    main()
