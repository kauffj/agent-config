#!/usr/bin/env python3
"""Fleet registry — the single data source the picker, tab bar, and tooling read.

Joins three things per live session:
  - liveness/identity  (_claude_sessions_lib.live_sessions)
  - live state          (~/.claude/state/<sid>.json, written by session-state.sh)
  - user metadata       (~/.claude/meta/<sid>.json: group, priority, label)

Usage:
  claude-sessions            urgency-sorted table (human)
  claude-sessions --json     records for the WezTerm picker / other tools
  claude-sessions --group    table grouped by `group`
"""
import json
import math
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _claude_sessions_lib import (live_sessions, other_vendor_sessions,  # noqa: E402
                                  proc_pane_id, CLAUDE_DIR, _project_dir)

STATE_DIR = os.path.join(CLAUDE_DIR, "state")
META_DIR = os.path.join(CLAUDE_DIR, "meta")


def _load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


_CMD_RE = re.compile(r"<command-name>(.*?)</command-name>", re.S)
_ARGS_RE = re.compile(r"<command-args>(.*?)</command-args>", re.S)

TOPIC_LIMIT = 60


def _clip(s, limit=TOPIC_LIMIT):
    """Squeeze whitespace and cut to `limit` — at a word boundary when one is
    reasonably near, with an ellipsis so a cut never reads as the whole."""
    s = " ".join((s or "").split())
    if len(s) <= limit:
        return s
    cut = s[:limit]
    if " " in cut[limit // 2:]:
        cut = cut[:cut.rfind(" ")]
    return cut + "…"


def _plain(txt):
    """A human-typed line worth showing: not command/notification XML, not the
    boilerplate the harness injects around skills and interrupted runs."""
    txt = (txt or "").strip()
    if (not txt or txt.startswith("<") or txt.startswith("Caveat:")
            or txt.startswith("Base directory for this skill")
            or txt.startswith("[Request interrupted")):
        return ""
    return txt


def _user_texts(ev):
    c = (ev.get("message") or {}).get("content")
    if isinstance(c, str):
        return [c]
    if isinstance(c, list):
        return [b.get("text") or "" for b in c
                if isinstance(b, dict) and b.get("type") == "text"]
    return []


# Commands that configure the harness rather than say what the session is
# for: as a founding input they identify nothing ("/model fable" could open
# any session), so scanning continues past them to the first substantive one.
_NOISE_CMDS = frozenset((
    "clear", "compact", "config", "context", "cost", "doctor", "exit",
    "export", "fast", "help", "hooks", "ide", "login", "logout", "mcp",
    "memory", "model", "output-style", "permissions", "quit", "rc",
    "release-notes", "rename", "resume", "status", "statusline",
    "terminal-setup", "usage", "vim",
))


def _founding_input(ev):
    """The session's first substantive input, for sessions with no title: a
    slash-command invocation ('/plan migrate auth'), a human-typed prompt, or
    a queued prompt. None if this event isn't one of those. Every text block
    is tried, not just the first — an image paste puts a caveat block ahead
    of what the person actually typed."""
    t = ev.get("type")
    if t == "user" and not ev.get("isMeta"):
        for txt in _user_texts(ev):
            m = _CMD_RE.search(txt)
            if m:
                cmd = m.group(1).strip()
                if cmd.lstrip("/") in _NOISE_CMDS:
                    continue
                args = _ARGS_RE.search(txt)
                return ("%s %s" % (cmd, args.group(1).strip() if args else "")
                        ).strip()
            txt = _plain(txt)
            if txt:
                return txt
    elif t == "queue-operation" and ev.get("operation") == "enqueue":
        return _plain(ev.get("content")) or None
    return None


# Codex replays AGENTS.md into the transcript as the opening "user" turn, so
# the first message is boilerplate identical across every session.
_CODEX_INJECTED = ("# AGENTS.md", "<INSTRUCTIONS>", "<environment_context>",
                   "<user_instructions>")


def _codex_topic(path, limit=TOPIC_LIMIT):
    """First real user turn of a Codex rollout. Codex writes no title event, so
    the opening prompt is the only thing that says what the session is about —
    once the injected instruction preamble is skipped."""
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            for line in f:
                if '"user"' not in line:
                    continue
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                payload = ev.get("payload") or {}
                if payload.get("role") != "user":
                    continue
                content = payload.get("content")
                if isinstance(content, list):
                    content = " ".join(b.get("text", "") for b in content
                                       if isinstance(b, dict))
                txt = _plain(content if isinstance(content, str) else "")
                if txt and not txt.lstrip().startswith(_CODEX_INJECTED):
                    return _clip(txt, limit)
    except OSError:
        pass
    return ""


# Claude Code re-emits the title event(s) every few turns, so the CURRENT
# title always sits near EOF (measured 2026-08-24: within ~31KB across every
# live transcript) and the read stays O(tail) however big the file grows.
_TITLE_TAIL_BYTES = 256 * 1024
_FOUNDING_SCAN_LINES = 400   # founding input, if any, is in the first turns


def _current_titles(path):
    """(custom, ai): the newest custom-title (/rename) and ai-title events in
    the transcript's tail. (None, None) when the tail has neither — which,
    given the re-emission, means the session has no title at all."""
    custom = ai = None
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - _TITLE_TAIL_BYTES))
            lines = f.read().split(b"\n")
        if size > _TITLE_TAIL_BYTES:
            lines = lines[1:]          # partial first line
        for raw in lines:
            if b'"custom-title"' not in raw and b'"ai-title"' not in raw:
                continue
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            if ev.get("type") == "custom-title" and ev.get("customTitle"):
                custom = ev["customTitle"]
            elif ev.get("type") == "ai-title" and ev.get("aiTitle"):
                ai = ev["aiTitle"]
    except OSError:
        pass
    return custom, ai


def _topic(sid, cwd, limit=TOPIC_LIMIT):
    """What a session is about, by authority: the user's /rename
    (custom-title) beats Claude Code's generated ai-title — which keeps being
    re-emitted AFTER a rename, so precedence is by type, not recency — and
    either beats the fallback, the session's founding input (command-started
    sessions often never get a title)."""
    if not cwd:
        return ""
    path = os.path.join(_project_dir(cwd), sid + ".jsonl")
    custom, ai = _current_titles(path)
    if custom or ai:
        return _clip(custom or ai, limit)
    fallback = None
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            for _ in range(_FOUNDING_SCAN_LINES):
                line = f.readline()
                if not line:
                    break
                if ('"user"' in line or "command-name" in line
                        or "queue-operation" in line):
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    fallback = _founding_input(ev)
                    if fallback:
                        break
    except OSError:
        return ""
    return _clip(fallback, limit)


def _git_branch(cwd):
    if not cwd:
        return None
    try:
        r = subprocess.run(["git", "-C", cwd, "symbolic-ref", "--short", "HEAD"],
                           capture_output=True, text=True, timeout=1)
        return r.stdout.strip() or None
    except Exception:
        return None


def _label(sid, cwd, branch):
    lf = "/tmp/.tab-label-%s" % sid
    if os.path.exists(lf):
        try:
            return open(lf).read().strip()
        except OSError:
            pass
    tag = "·%s" % sid[:4]
    # main/master carry no signal — the folder is the real identity (its own
    # column), so only lead with the branch when it's a meaningful feature branch.
    if branch and branch.lower() not in ("main", "master"):
        return "%s %s" % (branch, tag)
    return tag


def _glyph(status, age, ceiling):
    """Graduated urgency, matching the tab bar's relative model instead of turning
    everything red after 10 minutes: band a log-scaled fraction of `ceiling`
    (= max(2h, longest current wait)) into green -> yellow -> orange -> red."""
    if status == "delegating":
        return "◐"                    # parked on subagents; wakes itself
    if status != "waiting":
        return "·"                    # · working
    if age <= 0 or ceiling <= 1:
        return "\U0001F7E2"           # 🟢
    t = (math.log(1 + age) / math.log(1 + ceiling)) ** 1.8
    if t >= 0.80:
        return "\U0001F534"           # 🔴 red    — most neglected
    if t >= 0.55:
        return "\U0001F7E0"           # 🟠 orange
    if t >= 0.30:
        return "\U0001F7E1"           # 🟡 yellow
    return "\U0001F7E2"               # 🟢 green   — recent


def _age_str(age):
    if age < 60:
        return "%ds" % age
    if age < 3600:
        return "%dm" % (age // 60)
    return "%dh" % (age // 3600)


def _urgency(status, age, priority):
    # waiting floats above working; older waits float higher; priority dominates.
    base = (1000 + age) if status == "waiting" else (age // 10)
    return base + priority * 100000


def records():
    # The fleet is every agent competing for attention in these tabs, not just
    # the Claude ones: a Codex session you cannot see in the picker is a
    # session you forget you left running.
    live = dict(live_sessions())
    live.update(other_vendor_sessions())
    now = time.time()
    out, maxwait = [], 0
    for sid, info in live.items():
        cwd = info.get("cwd") or ""
        vendor = info.get("vendor") or "claude"
        # Only Claude writes state files (its SessionStart/Stop hooks); another
        # vendor's liveness is all we get, so it reads as plain "working".
        st = _load(os.path.join(STATE_DIR, "%s.json" % sid))
        meta = _load(os.path.join(META_DIR, "%s.json" % sid))
        status = st.get("status") or "working"
        # Stale-delegating degrade (same 30m window as wezterm.lua's
        # DELEGATE_STALE_S): a delegating claim whose `updated` stopped moving
        # means the hook's agents counter is stuck — surface it as waiting
        # rather than letting the session sleep un-pinged forever.
        if status == "delegating" and now - (st.get("updated") or now) > 1800:
            status = "waiting"
        since = st.get("since")
        age = int(now - since) if since else 0
        if status == "waiting" and age > maxwait:
            maxwait = age
        priority = int(meta.get("priority", 0) or 0)
        branch = _git_branch(cwd)
        out.append({
            "session_id": sid,
            "cwd": cwd,
            "project": os.path.basename(cwd) if cwd else "",
            "branch": branch,
            "label": meta.get("label") or _label(sid, cwd, branch),
            "vendor": vendor,
            # Each vendor says what a session is about differently: Claude has
            # an ai-title event, Grok writes summary.json (handed over by the
            # adapter), Codex has neither so its opening prompt is parsed.
            "topic": (_topic(sid, cwd) if vendor == "claude"
                      else _clip(info["topic"]) if info.get("topic")
                      else _codex_topic(info.get("transcript") or "")
                      if vendor == "codex" else ""),
            "pid": info.get("pid"),
            "source": info.get("source"),
            "status": status,
            "since": since,
            "age": age,
            "age_str": _age_str(age),
            "glyph": None,   # filled below, once the relative ceiling is known
            "group": meta.get("group"),
            "priority": priority,
            # no hook to record the pane, so read it off the live process
            "wezterm_pane": (st.get("wezterm_pane")
                             or (proc_pane_id(info["pid"]) if info.get("pid")
                                 and vendor != "claude" else None)),
            "urgency": _urgency(status, age, priority),
        })
    ceiling = max(7200, maxwait)   # 2h floor, else the longest current wait
    for r in out:
        r["glyph"] = _glyph(r["status"], r["age"], ceiling)
    out.sort(key=lambda r: (-r["urgency"], r["project"]))
    return out


def _print_table(recs, grouped=False):
    if not recs:
        print("no live sessions")
        return

    def row(r):
        grp = " [%s]" % r["group"] if r.get("group") else ""
        # vendor is silent for Claude and named for everything else, so the
        # common case stays uncluttered and a foreign session is unmistakable
        vend = "" if r.get("vendor", "claude") == "claude" else " <%s>" % r["vendor"]
        return "%s  %-30s %-8s %4s  %s%s%s" % (
            r["glyph"], r["label"][:30], r["status"], r["age_str"],
            r["project"], vend, grp)

    if grouped:
        seen = {}
        for r in recs:
            seen.setdefault(r.get("group") or "(ungrouped)", []).append(r)
        for grp in sorted(seen):
            print("\n== %s ==" % grp)
            for r in seen[grp]:
                print(row(r))
    else:
        for r in recs:
            print(row(r))


def main():
    args = sys.argv[1:]
    recs = records()
    if "--json" in args:
        print(json.dumps(recs))
    else:
        _print_table(recs, grouped="--group" in args)


if __name__ == "__main__":
    main()
