#!/usr/bin/python3 -E
"""Launch Codex with narrow Git access for a validated linked worktree."""

import json
import os
from pathlib import Path
import pwd
import re
import selectors
import stat
import subprocess
import sys
import time
from collections import deque

import _codex_git_access as git_access


RUNTIME_PROFILE = "codex-git-linked-runtime"
FLEET_RUNTIME_PROFILE = "codex-git-fleet-runtime"
GUARDED_RUNTIME_PROFILE = "codex-guarded-runtime"
RESERVED_RUNTIME_PROFILES = (
    RUNTIME_PROFILE, FLEET_RUNTIME_PROFILE, GUARDED_RUNTIME_PROFILE,
)
POLICY_OVERRIDES = ("default_permissions", "permissions.", "sandbox_mode", "sandbox_workspace_write")
GIT_BIN = Path("/usr/bin/git")
SYSTEM_UID = Path("/").stat().st_uid
GIT_ROUTING_KEYS = frozenset({
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CEILING_DIRECTORIES", "GIT_COMMON_DIR",
    "GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM",
    "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_SYSTEM", "GIT_DIR",
    "GIT_DISCOVERY_ACROSS_FILESYSTEM", "GIT_EXEC_PATH", "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NAMESPACE", "GIT_NO_REPLACE_OBJECTS", "GIT_OBJECT_DIRECTORY", "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE", "GIT_SHALLOW_FILE", "GIT_WORK_TREE",
})
USER_EXECUTABLE_ROOTS = frozenset({".local", ".nvm"})
ACTIVE_GIT_HOOKS = frozenset({
    "applypatch-msg", "commit-msg", "fsmonitor-watchman", "p4-changelist",
    "p4-post-changelist", "p4-pre-submit", "p4-prepare-changelist", "post-applypatch",
    "post-checkout", "post-commit", "post-index-change", "post-merge", "post-receive",
    "post-rewrite", "post-update", "pre-applypatch", "pre-auto-gc", "pre-commit",
    "pre-merge-commit", "pre-push", "pre-rebase", "pre-receive", "prepare-commit-msg",
    "proc-receive", "push-to-checkout", "reference-transaction", "sendemail-validate",
    "update",
})
FLEET_SCAN_MAX_DEPTH = 3
FLEET_SCAN_MAX_REPOSITORIES = 256
FLEET_SCAN_MAX_DIRECTORIES = 4096
FLEET_SCAN_MAX_ENTRIES = 32768
EXACT_PROFILE_ARG_MAX_BYTES = 48 * 1024
EXEC_ARG_MAX_BYTES = int(os.sysconf("SC_ARG_MAX"))
EXACT_PROFILE_TOTAL_MAX_BYTES = min(512 * 1024, EXEC_ARG_MAX_BYTES // 4)
GIT_OUTPUT_MAX_BYTES = 8 * 1024 * 1024
GIT_TIMEOUT_SECONDS = 10
FLEET_PRUNE = frozenset({
    ".cache", ".git", ".next", ".venv", ".workspaces", "build", "coverage",
    "dist", "node_modules", "target", "venv",
})


def trusted_executable(path):
    """Accept an executable only below non-peer-writable root/user directories."""
    for index, item in enumerate((path, *path.parents)):
        flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
        if index > 0:
            flags |= os.O_DIRECTORY
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            fd = os.open(item, flags)
        except OSError:
            return False
        try:
            info = os.fstat(fd)
            expected_type = stat.S_ISREG(info.st_mode) if index == 0 else stat.S_ISDIR(info.st_mode)
            if (not expected_type or info.st_uid not in {SYSTEM_UID, os.getuid()}
                    or git_access.writable_by_peer(info, fd, item)):
                return False
            if index == 0 and not info.st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH):
                return False
        finally:
            os.close(fd)
    return True


def trusted_candidate(raw, boundary):
    if not raw.is_absolute() or (boundary is not None and inside(raw, boundary)):
        return None
    try:
        resolved = raw.resolve(strict=True)
    except OSError:
        return None
    home = account_home()
    if boundary is None and home is not None and inside(resolved, home):
        relative = resolved.relative_to(home)
        if not relative.parts or relative.parts[0] not in USER_EXECUTABLE_ROOTS:
            return None
    if ((boundary is not None and inside(resolved, boundary))
            or not trusted_executable(resolved)):
        return None
    return resolved


def find_node(codex_directory, boundary):
    directories = [codex_directory]
    directories.extend(
        Path(raw).expanduser() for raw in os.environ.get("PATH", "").split(os.pathsep)
        if raw and Path(raw).expanduser().is_absolute()
    )
    seen = set()
    for directory in directories:
        candidate = directory / "node"
        if candidate in seen:
            continue
        seen.add(candidate)
        resolved = trusted_candidate(candidate, boundary)
        if resolved is not None:
            return resolved
    raise RuntimeError("real Codex uses Node, but no trusted Node executable was found")


def codex_command(candidate, resolved, boundary):
    try:
        with resolved.open("rb") as source:
            prefix = source.read(128)
    except OSError as exc:
        raise RuntimeError(f"could not inspect the real Codex executable: {exc}") from exc
    if prefix.startswith(b"\x7fELF"):
        return {"program": resolved, "argv": [str(resolved)]}
    first_line = prefix.splitlines()[0] if prefix else b""
    if first_line == b"#!/usr/bin/env node":
        node = find_node(candidate.parent, boundary)
        return {"program": node, "argv": [str(node), str(resolved)]}
    raise RuntimeError(f"unsupported real Codex entry point: {first_line!r}")


def find_real_codex(cwd):
    own = Path(__file__).resolve()
    # A non-Git umbrella such as ~/projects is still project-controlled input.
    # Do not execute a Codex or Node binary found anywhere below it.
    boundary = executable_boundary(cwd)
    for raw_dir in os.environ.get("PATH", "").split(os.pathsep):
        directory = Path(raw_dir).expanduser()
        if not raw_dir or not directory.is_absolute():
            continue
        candidate = directory / "codex"
        resolved = trusted_candidate(candidate, boundary)
        if resolved is None:
            continue
        if resolved == own:
            continue
        return codex_command(candidate, resolved, boundary)
    raise RuntimeError("could not find the real Codex executable after the managed launcher")


def executable_boundary(cwd):
    boundary = project_boundary(cwd)
    if boundary is not None:
        return boundary
    raw_boundary = raw_git_boundary(cwd)
    if raw_boundary is not None:
        return raw_boundary
    # Preserve ordinary `codex` launches from the user's home: user-managed
    # Node/Codex installs normally live below it. Narrower non-Git workspaces
    # remain project-controlled boundaries (notably ~/projects).
    home = account_home()
    return None if cwd == home else cwd


def account_home():
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=True)
    except (KeyError, OSError):
        return None


def account_home_is_read_only(cwd):
    """Return true when the broad account-home workspace must not be writable."""
    return cwd == account_home()


def validated_codex_home(cwd, access, home):
    """Accept Codex config only from a trusted directory outside project input."""
    raw = os.environ.get("CODEX_HOME")
    candidate = Path(raw) if raw else home / ".codex"
    if not candidate.is_absolute():
        raise RuntimeError("CODEX_HOME must be an absolute trusted path")
    try:
        candidate = candidate.resolve(strict=True)
    except OSError as exc:
        raise RuntimeError(f"CODEX_HOME cannot be resolved safely: {candidate}") from exc
    boundary = executable_boundary(cwd)
    default_home_config = cwd == home and candidate == home / ".codex"
    if cwd == home and not default_home_config:
        raise RuntimeError(
            f"account-home launches require the default CODEX_HOME: {home / '.codex'}")
    if boundary is not None and inside(candidate, boundary) and not default_home_config:
        raise RuntimeError(f"CODEX_HOME is project-controlled: {candidate}")
    access.secure_fs.validate_trusted_path(candidate)
    open_safe_directory(access, candidate)
    return candidate


def invocation_options(args):
    value = None
    policy_override = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            break
        if arg in {"-C", "--cd"}:
            if index + 1 >= len(args):
                break
            value = args[index + 1]
            index += 2
            continue
        if arg.startswith("-C") and len(arg) > 2:
            value = arg[2:]
        if arg.startswith("--cd="):
            value = arg.split("=", 1)[1]
        if arg in {
            "-s", "--sandbox", "-p", "--profile",
            "--dangerously-bypass-approvals-and-sandbox",
            "--ignore-user-config",
        }:
            policy_override = True
        if (arg.startswith("--sandbox=") or arg.startswith("--profile=")
                or (arg.startswith("-s") and len(arg) > 2)
                or (arg.startswith("-p") and len(arg) > 2)):
            policy_override = True
        config_value = None
        if arg in {"-c", "--config"} and index + 1 < len(args):
            config_value = args[index + 1]
            index += 1
        elif arg.startswith("--config="):
            config_value = arg.split("=", 1)[1]
        elif arg.startswith("-c") and len(arg) > 2:
            config_value = arg[2:]
        if config_value is not None:
            key = config_value.split("=", 1)[0].strip()
            if key.startswith(POLICY_OVERRIDES):
                policy_override = True
        index += 1
    path = Path(value).expanduser() if value is not None else Path.cwd()
    try:
        cwd = path.resolve(strict=True)
    except OSError:
        cwd = Path.cwd().resolve()
    return {"cwd": cwd, "policyOverride": policy_override}


def scrub_git_routing(environment):
    """Remove inherited variables that can redirect or reconfigure Git."""
    clean = environment.copy()
    for key in list(clean):
        if key in GIT_ROUTING_KEYS or key.startswith(
                ("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_", "GIT_TRACE")):
            clean.pop(key, None)
    return clean


def bounded_process(command, env, label):
    """Run one trusted binary while bounding combined captured output."""
    process = subprocess.Popen(
        command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    selected = selectors.DefaultSelector()
    buffers = {"stdout": [], "stderr": []}
    total = 0
    deadline = time.monotonic() + GIT_TIMEOUT_SECONDS
    try:
        selected.register(process.stdout, selectors.EVENT_READ, "stdout")
        selected.register(process.stderr, selectors.EVENT_READ, "stderr")
        while selected.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"{label} timed out")
            events = selected.select(remaining)
            if not events:
                raise RuntimeError(f"{label} timed out")
            for key, _mask in events:
                chunk = os.read(
                    key.fileobj.fileno(),
                    min(65536, GIT_OUTPUT_MAX_BYTES - total + 1))
                if not chunk:
                    selected.unregister(key.fileobj)
                    continue
                buffers[key.data].append(chunk)
                total += len(chunk)
                if total > GIT_OUTPUT_MAX_BYTES:
                    raise RuntimeError(f"{label} output exceeded the safety limit")
        remaining = max(0, deadline - time.monotonic())
        try:
            returncode = process.wait(timeout=remaining)
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(f"{label} timed out") from exc
    except BaseException:
        process.kill()
        process.wait()
        raise
    finally:
        selected.close()
        process.stdout.close()
        process.stderr.close()
    try:
        stdout = b"".join(buffers["stdout"]).decode()
        stderr = b"".join(buffers["stderr"]).decode()
    except UnicodeDecodeError as exc:
        raise RuntimeError(f"{label} returned invalid text") from exc
    return {"returncode": returncode, "stdout": stdout, "stderr": stderr}


def git_output(cwd, *args):
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = bounded_process(
        [str(GIT_BIN), "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
         "-C", str(cwd), *args], env, "Git repository lookup")
    if result["returncode"]:
        raise RuntimeError(result["stderr"].strip() or "Git repository lookup failed")
    return result["stdout"].strip()


def open_safe_directory(access, path):
    fd, _info = access.open_owned_directory(path)
    os.close(fd)


def ensure_guard_directory(access, path):
    """Create one standard Git metadata directory without following links."""
    path = Path(path)
    parent_fd, _parent = access.open_owned_directory(path.parent)
    created = False
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent_fd)
            created = True
        except FileExistsError:
            pass
        if created:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            fd = os.open(path.name, flags, dir_fd=parent_fd)
            try:
                os.fchmod(fd, 0o700)
                access.clear_inherited_access_acl(fd, path)
                os.fsync(fd)
            finally:
                os.close(fd)
    finally:
        os.close(parent_fd)
    open_safe_directory(access, path)


def ensure_guard_file(access, path):
    """Ensure an optional protected Git metadata file exists as an owned file."""
    path = Path(path)
    existing = access.secure_read(path, missing_ok=True)
    if existing["exists"]:
        return
    if existing["parent_missing"]:
        raise RuntimeError(f"guard-file parent is missing: {path.parent}")
    parent_fd, _parent = access.open_owned_directory(path.parent)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        try:
            fd = os.open(path.name, flags, 0o600, dir_fd=parent_fd)
        except FileExistsError:
            # A same-user race is outside the threat boundary, but still
            # revalidate the result instead of trusting what appeared.
            access.secure_read(path)
            return
        try:
            os.fchmod(fd, 0o600)
            access.clear_inherited_access_acl(fd, path)
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        os.close(parent_fd)
    access.secure_read(path)


def prepare_git_guards(common, worktree_config_paths, access):
    """Materialize optional read-only paths before Codex assembles mounts."""
    validate_git_guards(common, worktree_config_paths, access)
    materialize_git_guards(common, worktree_config_paths, access)


def validate_git_guards(common, worktree_config_paths, access):
    """Validate every existing protected source without changing the repo."""
    reject_local_config_indirection(
        [common / "config", common / "config.worktree", *worktree_config_paths], access)
    validate_active_hooks(common / "hooks", access)


def materialize_git_guards(common, worktree_config_paths, access):
    """Create the standard optional paths that the runtime profile guards."""
    ensure_guard_directory(access, common / "hooks")
    ensure_guard_directory(access, common / "info")
    ensure_guard_directory(access, common / "modules")
    ensure_guard_directory(access, common / "objects")
    ensure_guard_directory(access, common / "objects" / "info")
    ensure_guard_directory(access, common / "worktrees")
    for path in (
            common / "config.worktree",
            common / "objects" / "info" / "alternates",
            common / "objects" / "info" / "http-alternates",
            *worktree_config_paths):
        ensure_guard_file(access, path)


def reject_local_config_indirection(config_paths, access):
    """Reject local config paths that can escape the protected Git metadata."""
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    for index, path in enumerate(dict.fromkeys(map(Path, config_paths))):
        source = access.secure_read(path, missing_ok=index != 0)
        if not source["exists"]:
            continue
        result = bounded_process(
            [str(GIT_BIN), "-c", "core.fsmonitor=false",
             "-c", "core.hooksPath=/dev/null", "config", "--file", str(path),
             "--name-only", "--get-regexp",
             r"^(include(if\..*)?\.path|core\.(hookspath|fsmonitor))$"],
            env, f"local Git config validation: {path}")
        if result["returncode"] == 0:
            names = {name.casefold() for name in result["stdout"].splitlines()}
            if "core.hookspath" in names:
                raise RuntimeError(
                    f"local core.hooksPath is incompatible with protected Git access: {path}")
            if "core.fsmonitor" in names:
                raise RuntimeError(
                    f"local core.fsmonitor is incompatible with protected Git access: {path}")
            raise RuntimeError(
                f"local Git config includes are incompatible with protected Git access: {path}")
        if result["returncode"] != 1:
            raise RuntimeError(
                result["stderr"].strip()
                or f"could not validate local Git config indirection: {path}")


def validate_active_hooks(hooks, access):
    """Reject active hook entries that escape the guarded hooks directory."""
    try:
        directory_fd, _directory = access.open_owned_directory(hooks)
    except access.Refusal as exc:
        if isinstance(exc.__cause__, FileNotFoundError):
            return
        raise
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        for name in ACTIVE_GIT_HOOKS:
            try:
                fd = os.open(name, flags, dir_fd=directory_fd)
            except FileNotFoundError:
                continue
            except OSError as exc:
                raise RuntimeError(f"active Git hook {hooks / name} cannot be opened safely") from exc
            try:
                info = os.fstat(fd)
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_nlink != 1 or access.writable_by_peer(info, fd, hooks / name)):
                    raise RuntimeError(
                        f"active Git hook {hooks / name} is not one protected owned file")
            finally:
                os.close(fd)
    finally:
        os.close(directory_fd)


def resolve_pointer(base, raw):
    value = Path(raw)
    candidate = value if value.is_absolute() else base / value
    return candidate.resolve(strict=True)


def inside(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def raw_git_boundary(cwd):
    current = cwd
    while True:
        try:
            (current / ".git").lstat()
            if current != cwd or not sandbox_direct_git_mountpoint(cwd):
                return current
        except FileNotFoundError:
            pass
        parent = current.parent
        if parent == current:
            return None
        current = parent


def has_raw_git_marker(cwd):
    return raw_git_boundary(cwd) is not None


def sandbox_direct_git_mountpoint(cwd):
    """Recognize Codex's invalid read-only `.git` mount at a non-Git root."""
    marker = cwd / ".git"
    try:
        info = marker.lstat()
        if not stat.S_ISDIR(info.st_mode):
            return False
        with os.scandir(marker) as entries:
            first = next(entries, None)
        if first is None:
            return True
        # Permission rules for optional read-only Git paths can materialize
        # zero-byte placeholders. A real checkout always has HEAD, objects,
        # and refs, and its metadata root is writable by its owner.
        if info.st_mode & stat.S_IWUSR:
            return False
        return not any((marker / name).exists() for name in ("HEAD", "objects", "refs"))
    except OSError:
        return False


def project_boundary(cwd):
    try:
        root = Path(git_output(cwd, "rev-parse", "--show-toplevel")).resolve(strict=True)
    except RuntimeError:
        return None
    return root if inside(cwd, root) else None


def linked_worktree(cwd, access):
    try:
        root = Path(git_output(cwd, "rev-parse", "--show-toplevel")).resolve(strict=True)
    except RuntimeError:
        if sandbox_direct_git_mountpoint(cwd):
            return None
        if has_raw_git_marker(cwd):
            raise
        return None
    if not inside(cwd, root):
        raise RuntimeError("Git reported a checkout that does not contain the invocation directory")
    git_dir = Path(git_output(cwd, "rev-parse", "--absolute-git-dir")).resolve(strict=True)
    common = Path(git_output(
        cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve(strict=True)
    if inside(git_dir, root):
        return None

    worktrees = common / "worktrees"
    for path in (root, git_dir, common, worktrees):
        access.secure_fs.validate_trusted_path(path)
    open_safe_directory(access, root)
    open_safe_directory(access, git_dir)
    open_safe_directory(access, common)
    open_safe_directory(access, worktrees)
    if git_dir.parent != worktrees:
        raise RuntimeError("external Git directory is not a linked-worktree admin directory")

    pointer_path = root / ".git"
    pointer = access.secure_read(pointer_path)
    match = re.fullmatch(r"gitdir: ([^\r\n]+)\r?\n?", pointer["text"])
    if not match or resolve_pointer(root, match.group(1)) != git_dir:
        raise RuntimeError("worktree .git pointer does not match Git's resolved directory")

    commondir = access.secure_read(git_dir / "commondir")["text"].strip()
    if not commondir or resolve_pointer(git_dir, commondir) != common:
        raise RuntimeError("worktree commondir pointer does not match Git's common directory")
    gitdir_pointer = access.secure_read(git_dir / "gitdir")["text"].strip()
    if not gitdir_pointer or resolve_pointer(git_dir, gitdir_pointer) != pointer_path:
        raise RuntimeError("worktree gitdir back-pointer does not match the checkout")

    listed = []
    for line in git_output(cwd, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            try:
                listed.append(Path(line[9:]).resolve(strict=True))
            except OSError:
                continue
    if root not in listed:
        raise RuntimeError("linked checkout is absent from git worktree list")
    return {"root": root, "gitDir": git_dir, "common": common, "name": git_dir.name}


def discover_ordinary_checkouts(root, protected_markers=None):
    """Find bounded descendant checkouts below a non-Git umbrella.

    Only ordinary `.git` directories are candidates. Linked worktrees and
    submodules use pointer files and need their own exact external-directory
    validation; their ordinary parent checkout is enough for fleet launches.
    """
    queue = deque([(root, 0)])
    found = []
    directories_seen = 0
    entries_seen = 0
    while queue:
        directory, depth = queue.popleft()
        directories_seen += 1
        if directories_seen > FLEET_SCAN_MAX_DIRECTORIES:
            print(
                f"codex-worktree: child scan stopped after "
                f"{FLEET_SCAN_MAX_DIRECTORIES} directories below {root}", file=sys.stderr)
            return found
        marker = directory / ".git"
        try:
            marker_info = marker.lstat()
        except FileNotFoundError:
            marker_info = None
        except OSError as exc:
            raise RuntimeError(f"cannot inspect {marker}: {exc}") from exc
        if marker_info is not None:
            if stat.S_ISDIR(marker_info.st_mode):
                # Codex's sandbox may leave an empty `.git` mountpoint at a
                # non-Git workspace root. Only stop descending when Git itself
                # confirms this directory is the checkout root.
                try:
                    reported = Path(
                        git_output(directory, "rev-parse", "--show-toplevel")
                    ).resolve(strict=True)
                except RuntimeError:
                    reported = None
                if reported == directory:
                    if protected_markers is not None:
                        protected_markers.append(marker)
                    found.append(directory)
                    if len(found) >= FLEET_SCAN_MAX_REPOSITORIES:
                        print(
                            f"codex-worktree: child scan stopped after "
                            f"{FLEET_SCAN_MAX_REPOSITORIES} repositories below {root}",
                            file=sys.stderr)
                        return found
                    continue
            elif stat.S_ISREG(marker_info.st_mode):
                # A valid pointer-file checkout is a submodule or linked
                # worktree, not an ordinary child root for this fleet path.
                try:
                    reported = Path(
                        git_output(directory, "rev-parse", "--show-toplevel")
                    ).resolve(strict=True)
                except RuntimeError:
                    reported = None
                if reported == directory:
                    if protected_markers is not None:
                        protected_markers.append(marker)
                    continue
        if depth >= FLEET_SCAN_MAX_DEPTH:
            continue
        children = []
        try:
            with os.scandir(directory) as entries:
                for entry in entries:
                    entries_seen += 1
                    if entries_seen > FLEET_SCAN_MAX_ENTRIES:
                        print(
                            f"codex-worktree: child scan stopped after "
                            f"{FLEET_SCAN_MAX_ENTRIES} entries below {root}", file=sys.stderr)
                        return found
                    if (entry.name in FLEET_PRUNE or entry.name.startswith(".")
                            or not entry.is_dir(follow_symlinks=False)):
                        continue
                    children.append(Path(entry.path))
        except OSError as exc:
            print(f"codex-worktree: child scan skipped {directory}: {exc}", file=sys.stderr)
            continue
        for child in sorted(children):
            queue.append((child, depth + 1))
    return found


def discover_submodule_markers(root, access):
    """Find initialized gitlink markers and validate their resolved Git dirs."""
    queue = deque([(root, 0)])
    markers = []
    seen = set()
    while queue:
        checkout, depth = queue.popleft()
        if checkout in seen:
            continue
        seen.add(checkout)
        output = git_output(checkout, "ls-files", "--stage", "-z")
        for record in output.split("\0"):
            if not record or "\t" not in record:
                continue
            header, raw_path = record.split("\t", 1)
            if header.split(" ", 1)[0] != "160000":
                continue
            candidate = checkout / raw_path
            try:
                submodule = candidate.resolve(strict=True)
            except OSError:
                continue
            if not inside(submodule, root):
                raise RuntimeError(f"submodule path escapes its checkout: {candidate}")
            marker = submodule / ".git"
            try:
                info = marker.lstat()
            except FileNotFoundError:
                continue
            if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
                raise RuntimeError(f"submodule marker has an unsafe type: {marker}")
            access.secure_fs.validate_trusted_path(marker)
            markers.append(marker)
            if stat.S_ISREG(info.st_mode):
                pointer = access.secure_read(marker)
                match = re.fullmatch(r"gitdir: ([^\r\n]+)\r?\n?", pointer["text"])
                if not match:
                    raise RuntimeError(f"submodule marker is not a valid Git pointer: {marker}")
                git_dir = resolve_pointer(submodule, match.group(1))
                access.secure_fs.validate_trusted_path(git_dir)
                open_safe_directory(access, git_dir)
                reported = Path(git_output(
                    submodule, "rev-parse", "--absolute-git-dir")).resolve(strict=True)
                if reported != git_dir:
                    raise RuntimeError(
                        f"submodule pointer does not match Git's resolved directory: {marker}")
                markers.append(git_dir)
            else:
                access.secure_fs.validate_trusted_path(marker)
                open_safe_directory(access, marker)
            if len(markers) > FLEET_SCAN_MAX_REPOSITORIES:
                raise RuntimeError("submodule protected-path count exceeded the safety limit")
            if depth < FLEET_SCAN_MAX_DEPTH:
                queue.append((submodule, depth + 1))
    return markers


def ordinary_checkout(root, access):
    """Validate that a discovered marker is one ordinary checkout root."""
    reported = Path(git_output(root, "rev-parse", "--show-toplevel")).resolve(strict=True)
    git_dir = Path(git_output(root, "rev-parse", "--absolute-git-dir")).resolve(strict=True)
    common = Path(git_output(
        root, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve(strict=True)
    marker = root / ".git"
    marker_info = marker.lstat()
    if not stat.S_ISDIR(marker_info.st_mode):
        raise RuntimeError("ordinary checkout .git marker is not a real directory")
    expected = marker.resolve(strict=True)
    if reported != root or git_dir != expected or common != expected:
        raise RuntimeError("marker is not an ordinary checkout rooted at the discovered directory")
    access.secure_fs.validate_trusted_path(root)
    access.secure_fs.validate_trusted_path(expected)
    open_safe_directory(access, root)
    open_safe_directory(access, expected)
    return {"root": root}


def shared_worktrees_allow_git(
        root, expected_common, global_online, access, protected_configs,
        protected_git_paths, source_root, global_policy):
    """Honor sibling policy and return every linked worktree config to guard."""
    output = git_output(root, "worktree", "list", "--porcelain", "-z")
    worktree_configs = []
    worktree_roots = []
    allowed = True
    for field in output.split("\0"):
        if not field.startswith("worktree "):
            continue
        raw_path = field[len("worktree "):]
        try:
            worktree_root = Path(raw_path).resolve(strict=True)
        except OSError as exc:
            raise RuntimeError(
                f"cannot validate shared worktree {raw_path}: {exc}") from exc
        if worktree_root == root:
            continue
        worktree_roots.append(worktree_root)
        try:
            marker_info = (worktree_root / ".git").lstat()
        except OSError:
            marker_info = None
        if (marker_info is not None and stat.S_ISREG(marker_info.st_mode)
                and inside(worktree_root, source_root)):
            # Collect every source-side pointer before policy validation. A
            # later sibling failure must not leave unvisited in-tree pointers
            # writable under the fallback profile.
            protected_git_paths.append(worktree_root / ".git")

    for worktree_root in worktree_roots:
        try:
            context = linked_worktree(worktree_root, access)
            if context is None:
                context = ordinary_checkout(worktree_root, access)
                context["common"] = (worktree_root / ".git").resolve(strict=True)
            else:
                worktree_configs.append(context["gitDir"] / "config.worktree")
            if context["common"] != expected_common:
                raise RuntimeError("worktree does not resolve to the expected common Git directory")
            sibling_configs = []
            active = active_permission(
                context, worktree_root, access, protected_configs=sibling_configs,
                global_policy=global_policy)
            protected_configs.extend(
                path for path in sibling_configs if inside(path, source_root))
        except (RuntimeError, access.Refusal, OSError) as exc:
            raise RuntimeError(
                f"cannot validate shared worktree policy for {worktree_root}: {exc}") from exc
        child_online = active in {"git-workspace", "no-git"}
        if global_online and not child_online:
            print(
                f"codex-worktree: shared Git augmentation disabled for {root}: offline "
                f"policy at {worktree_root} requires a direct project launch; umbrella "
                "network access is session-wide", file=sys.stderr)
            allowed = False
            continue
        if active not in {"git-workspace", "git-workspace-offline"}:
            print(
                f"codex-worktree: shared Git augmentation disabled for {root}: "
                f"linked worktree opts out at {worktree_root}", file=sys.stderr)
            allowed = False
    return worktree_configs if allowed else None


def exact_profile_args(name, description, parent, rules):
    """Emit a chain of bounded inline profiles below Linux's per-arg cap."""
    normalized = sorted(set((str(path), mode) for path, mode in rules))
    chunks = []
    current = []
    for rule in normalized:
        candidate = [*current, rule]
        index = len(chunks)
        profile_name = f"{name}-{index}"
        profile_parent = parent if index == 0 else f"{name}-{index - 1}"
        argument = exact_profile_argument(
            profile_name, description, profile_parent, candidate)
        if len(argument.encode()) <= EXACT_PROFILE_ARG_MAX_BYTES:
            current = candidate
            continue
        if not current:
            raise RuntimeError(f"one filesystem rule exceeds the runtime profile argument budget")
        chunks.append(current)
        current = [rule]
    if current:
        chunks.append(current)

    arguments = []
    for index, chunk in enumerate(chunks):
        profile_name = f"{name}-{index}"
        profile_parent = parent if index == 0 else f"{name}-{index - 1}"
        argument = exact_profile_argument(profile_name, description, profile_parent, chunk)
        if len(argument.encode()) > EXACT_PROFILE_ARG_MAX_BYTES:
            raise RuntimeError("runtime profile argument budget was exceeded")
        arguments.extend(("-c", argument))
    final_name = f"{name}-{len(chunks) - 1}"
    arguments.extend(("-c", f"default_permissions={toml_string(final_name)}"))
    if argument_bytes(arguments) > EXACT_PROFILE_TOTAL_MAX_BYTES:
        raise RuntimeError("runtime profile arguments exceeded the total safety budget")
    return arguments


def argument_bytes(arguments):
    """Approximate execve string storage, including each terminating NUL."""
    return sum(len(os.fsencode(argument)) + 1 for argument in arguments)


def ensure_exec_budget(arguments, environment):
    """Leave headroom for Linux's argv/env pointer table and exec bookkeeping."""
    pointer_bytes = (len(arguments) + len(environment) + 2) * 8
    environment_bytes = argument_bytes(
        [f"{key}={value}" for key, value in environment.items()])
    payload = argument_bytes(arguments) + environment_bytes + pointer_bytes
    reserve = min(64 * 1024, EXEC_ARG_MAX_BYTES // 4)
    if payload > EXEC_ARG_MAX_BYTES - reserve:
        raise RuntimeError("aggregate exec argument budget was exceeded")


def exact_profile_argument(name, description, parent, rules):
    rule_text = ",".join(
        f"{toml_string(path)}={toml_string(mode)}" for path, mode in rules)
    profile = (
        f"{{description={toml_string(description)},extends={toml_string(parent)},"
        f"filesystem={{{rule_text}}}}}"
    )
    return f"permissions.{name}={profile}"


def normal_checkout_runtime(root, cwd, access):
    """Protect sibling-worktree config and initialized submodule pointers."""
    context = ordinary_checkout(root, access)
    protected_configs = []
    protected_git_paths = []
    global_policy = load_global_permission(access)
    active = active_permission(
        context, cwd, access, protected_configs=protected_configs,
        global_policy=global_policy)
    worktree_configs = shared_worktrees_allow_git(
        root, (root / ".git").resolve(strict=True),
        active in {"git-workspace", "no-git"}, access, protected_configs,
        protected_git_paths, root, global_policy)
    markers = discover_submodule_markers(root, access)
    protected_paths = [*markers, *protected_configs, *protected_git_paths]
    if active not in {"git-workspace", "git-workspace-offline"}:
        return exact_read_profile(active, protected_paths)
    if worktree_configs is None:
        fallback = "no-git" if active == "git-workspace" else "no-git-offline"
        return exact_read_profile(fallback, protected_paths)
    extra = exact_read_profile(active, protected_paths)
    prepare_git_guards(
        (root / ".git").resolve(strict=True), worktree_configs, access)
    return extra


def exact_read_profile(parent, paths):
    """Overlay exact read-only rules for project policy and nested Git paths."""
    if not paths:
        return ["-c", f"default_permissions={toml_string(parent)}"]
    return exact_profile_args(
        GUARDED_RUNTIME_PROFILE,
        "Project policy and nested Git control paths are read-only.", parent,
        [(path, "read") for path in paths])


def fleet_runtime_profile(roots, protected_markers, protected_configs, active):
    if active not in git_access.MANAGED_CHOICES:
        return []
    online = active in {"git-workspace", "no-git"}
    parent = "no-git" if online else "no-git-offline"
    enabled_markers = {root / ".git" for root in roots}
    read_only_markers = set(protected_markers) - enabled_markers
    if not roots and not read_only_markers and not protected_configs:
        # A non-Git umbrella is itself a workspace root. Do not apply the
        # relative Git profile there when no eligible child needs exact access.
        fallback = active if active in {"no-git", "no-git-offline"} else parent
        return ["-c", f"default_permissions={toml_string(fallback)}"]
    rules = [(marker, "read") for marker in read_only_markers]
    rules.extend((path, "read") for path in protected_configs)
    for root in roots:
        git_dir = root / ".git"
        rules.extend((
            (git_dir, "write"),
            (git_dir / "config", "read"),
            (git_dir / "config.worktree", "read"),
            (git_dir / "hooks", "read"),
            (git_dir / "modules", "read"),
            (git_dir / "objects" / "info" / "alternates", "read"),
            (git_dir / "objects" / "info" / "http-alternates", "read"),
            (git_dir / "worktrees", "read"),
        ))
    return exact_profile_args(
        FLEET_RUNTIME_PROFILE,
        "Exact fleet Git access with persistence paths read-only.", parent, rules)


def pinned_profile(active):
    if active in git_access.MANAGED_CHOICES:
        return ["-c", f"default_permissions={toml_string(active)}"]
    return []


def fleet_workspace_args(cwd, access):
    """Make eligible child repos effective roots for a non-Git umbrella."""
    arguments = []
    access.secure_fs.validate_trusted_path(cwd)
    open_safe_directory(access, cwd)
    protected_configs = []
    global_policy = load_global_permission(access)
    umbrella_active = active_permission(
        {"root": cwd}, cwd, access, protected_configs=protected_configs,
        global_policy=global_policy)
    umbrella_online = umbrella_active in {"git-workspace", "no-git"}
    roots = []
    guard_contexts = []
    protected_markers = []
    for root in discover_ordinary_checkouts(cwd, protected_markers):
        try:
            protected_markers.extend(discover_submodule_markers(root, access))
        except (RuntimeError, OSError) as exc:
            raise RuntimeError(f"cannot protect nested Git markers below {root}: {exc}") from exc
        context = ordinary_checkout(root, access)
        active = active_permission(
            context, root, access, base_active=umbrella_active,
            protected_configs=protected_configs, global_policy=global_policy)
        child_online = active in {"git-workspace", "no-git"}
        expected_common = (root / ".git").resolve(strict=True)
        worktree_configs = shared_worktrees_allow_git(
            root, expected_common, umbrella_online, access, protected_configs,
            protected_markers, cwd, global_policy)
        if umbrella_online and not child_online:
            print(
                f"codex-worktree: child Git augmentation disabled for {root}: offline "
                "policy requires a direct project launch; umbrella network access is "
                "session-wide", file=sys.stderr)
            continue
        if active not in {"git-workspace", "git-workspace-offline"}:
            print(
                f"codex-worktree: child Git augmentation disabled by local policy: {root}",
                file=sys.stderr)
            continue
        if worktree_configs is None:
            continue
        roots.append(root)
        guard_contexts.append((expected_common, worktree_configs))
    profile = fleet_runtime_profile(
        roots, protected_markers, protected_configs, umbrella_active)
    # Build and budget the full runtime profile before materializing guard
    # paths. A too-large fleet must fail closed without mutating repositories.
    for common, worktree_configs in guard_contexts:
        validate_git_guards(common, worktree_configs, access)
    for common, worktree_configs in guard_contexts:
        materialize_git_guards(common, worktree_configs, access)
    for root in roots:
        arguments.extend(("--add-dir", str(root)))
    arguments.extend(profile)
    return arguments


def config_layers(root, cwd):
    yield root / ".codex" / "config.toml"
    try:
        relative = cwd.relative_to(root)
    except ValueError:
        return
    cursor = root
    for part in relative.parts:
        cursor = cursor / part
        yield cursor / ".codex" / "config.toml"


def load_global_permission(access):
    source = access.secure_read(access.codex_home() / "config.toml")
    parsed = access.parse_toml(source["text"], source["path"])
    active = access.validate_managed_profiles(parsed, source["path"])
    reject_reserved_runtime_profiles(parsed, source["path"])
    return active


def active_permission(
        context, cwd, access, base_active=None, protected_configs=None,
        global_policy=None):
    global_active = (
        global_policy if global_policy is not None else load_global_permission(access))
    active = global_active if base_active is None else base_active
    for path in config_layers(context["root"], cwd):
        local_source = access.secure_read(path, missing_ok=True)
        if not local_source["exists"]:
            continue
        access.secure_fs.validate_trusted_path(path)
        if protected_configs is not None:
            protected_configs.append(path)
        local = access.parse_toml(local_source["text"], path)
        access.reject_project_managed_profiles(local, path)
        reject_reserved_runtime_profiles(local, path)
        if "sandbox_mode" in local or "sandbox_workspace_write" in local:
            raise RuntimeError(f"{path}: legacy sandbox policy prevents linked Git augmentation")
        choice = local.get("default_permissions")
        if choice is not None:
            if choice not in access.MANAGED_CHOICES:
                raise RuntimeError(f"{path}: unrelated permission profile {choice!r}")
            active_git = active in {"git-workspace", "git-workspace-offline"}
            active_network = active in {"git-workspace", "no-git"}
            chosen_git = choice in {"git-workspace", "git-workspace-offline"}
            chosen_network = choice in {"git-workspace", "no-git"}
            if chosen_git and not active_git:
                raise RuntimeError(f"{path}: local policy cannot re-enable Git access")
            if chosen_network and not active_network:
                raise RuntimeError(f"{path}: local policy cannot re-enable network access")
            active = choice
    return active


def reject_reserved_runtime_profiles(parsed, path):
    for name in parsed.get("permissions", {}):
        if any(name == reserved or name.startswith(f"{reserved}-")
               for reserved in RESERVED_RUNTIME_PROFILES):
            raise RuntimeError(f"{path}: reserved runtime profile name is already defined")


def toml_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def runtime_profile(context, active, protected_paths=()):
    if active == "git-workspace":
        parent = "no-git"
    elif active == "git-workspace-offline":
        parent = "no-git-offline"
    else:
        return None
    common = str(context["common"])
    admin = f"worktrees/{context['name']}"
    rules = [
        (".", "read"),
        ("objects", "write"),
        ("objects/info/alternates", "read"),
        ("objects/info/http-alternates", "read"),
        ("refs", "write"),
        ("logs/refs", "write"),
        ("FETCH_HEAD", "write"),
        ("FETCH_HEAD.lock", "write"),
        ("packed-refs", "write"),
        ("packed-refs.lock", "write"),
        ("packed-refs.new", "write"),
        (admin, "write"),
        (f"{admin}/commondir", "read"),
        (f"{admin}/gitdir", "read"),
        (f"{admin}/config.worktree", "read"),
        ("config", "read"),
        ("config.worktree", "read"),
        ("hooks", "read"),
        ("info", "read"),
        ("HEAD", "read"),
        ("index", "read"),
        ("logs/HEAD", "read"),
        ("worktrees", "read"),
    ]
    rule_text = ",".join(f"{toml_string(path)}={toml_string(mode)}" for path, mode in rules)
    profile = (
        "{description=\"Validated linked-worktree Git metadata access.\","
        f"extends={toml_string(parent)},"
        f"filesystem={{{toml_string(common)}={{{rule_text}}}}}}}"
    )
    arguments = [
        "--add-dir", common,
        "-c", f"permissions.{RUNTIME_PROFILE}={profile}",
    ]
    if protected_paths:
        arguments.extend(exact_profile_args(
            GUARDED_RUNTIME_PROFILE,
            "Project policy and nested Git control paths are read-only.", RUNTIME_PROFILE,
            [(path, "read") for path in protected_paths]))
    else:
        arguments.extend((
            "-c", f"default_permissions={toml_string(RUNTIME_PROFILE)}"))
    return arguments


def main():
    args = sys.argv[1:]
    invocation = invocation_options(args)
    try:
        home = account_home()
        if home is None:
            raise RuntimeError("could not resolve the account home directory")
        # Git and the final Codex process must not inherit a project-selected
        # home. CODEX_HOME may be explicit, but only outside project input and
        # below a fully trusted ancestry.
        os.environ["HOME"] = str(home)
        os.environ["CODEX_HOME"] = str(
            validated_codex_home(invocation["cwd"], git_access, home))
    except (RuntimeError, git_access.Refusal, OSError) as exc:
        print(f"codex-worktree: unsafe configuration environment: {exc}", file=sys.stderr)
        raise SystemExit(2)
    try:
        real = find_real_codex(invocation["cwd"])
    except RuntimeError as exc:
        print(f"codex-worktree: {exc}", file=sys.stderr)
        raise SystemExit(127)
    extra = []
    if not invocation["policyOverride"]:
        access = git_access
        try:
            cwd = invocation["cwd"]
            if account_home_is_read_only(cwd):
                # The trusted Codex/Node install and shell startup files live
                # below the account home. Never make that whole directory a
                # writable workspace merely because Codex started there.
                extra = ["-c", 'default_permissions=":read-only"']
            else:
                context = linked_worktree(cwd, access)
                if context is not None:
                    protected_configs = []
                    protected_git_paths = []
                    global_policy = load_global_permission(access)
                    active = active_permission(
                        context, cwd, access, protected_configs=protected_configs,
                        global_policy=global_policy)
                    worktree_configs = shared_worktrees_allow_git(
                        context["root"], context["common"],
                        active in {"git-workspace", "no-git"}, access,
                        protected_configs, protected_git_paths, context["root"],
                        global_policy)
                    markers = discover_submodule_markers(context["root"], access)
                    protected_paths = [
                        *markers, *protected_configs, *protected_git_paths]
                    if active in {"git-workspace", "git-workspace-offline"}:
                        if worktree_configs is None:
                            fallback = (
                                "no-git" if active == "git-workspace"
                                else "no-git-offline")
                            extra = exact_read_profile(fallback, protected_paths)
                        else:
                            extra = runtime_profile(context, active, protected_paths)
                            prepare_git_guards(
                                context["common"],
                                [context["gitDir"] / "config.worktree",
                                 *worktree_configs], access)
                    else:
                        extra = exact_read_profile(active, protected_paths)
                else:
                    boundary = project_boundary(cwd)
                    if boundary is not None:
                        extra = normal_checkout_runtime(boundary, cwd, access)
                    else:
                        extra = fleet_workspace_args(cwd, access)
        except (RuntimeError, access.Refusal, OSError) as exc:
            # A validation failure can involve project policy or a nested Git
            # control path, not only the top-level `.git`. Freeze the whole
            # workspace rather than letting the failed source rewrite the
            # boundary that will be trusted on the next launch.
            extra = ["-c", 'default_permissions=":read-only"']
            print(f"codex-worktree: Git augmentation failed closed: {exc}", file=sys.stderr)
    environment = scrub_git_routing(os.environ)
    for key in ("NODE_OPTIONS", "NODE_PATH"):
        environment.pop(key, None)
    launch_arguments = [*real["argv"], *extra, *args]
    try:
        ensure_exec_budget(launch_arguments, environment)
    except RuntimeError as exc:
        extra = ["--sandbox", "read-only"]
        launch_arguments = [*real["argv"], *extra, *args]
        print(f"codex-worktree: Git augmentation failed closed: {exc}", file=sys.stderr)
    os.execve(
        real["program"], launch_arguments, environment)


if __name__ == "__main__":
    main()
