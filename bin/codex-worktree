#!/usr/bin/python3 -E
"""Launch Codex with narrow Git access for a validated linked worktree."""

import json
import os
from pathlib import Path
import pwd
import re
import selectors
import stat
import subprocess
import sys
import time
from collections import deque

import _codex_git_access as git_access


RUNTIME_PROFILE = "codex-git-linked-runtime"
FLEET_RUNTIME_PROFILE = "codex-git-fleet-runtime"
RESERVED_RUNTIME_PROFILES = (RUNTIME_PROFILE, FLEET_RUNTIME_PROFILE)
POLICY_OVERRIDES = (
    "approval_policy", "default_permissions", "network_access", "permissions.",
    "sandbox_mode", "sandbox_permissions", "sandbox_workspace_write", "web_search",
)
PROJECT_PERMISSION_KEYS = frozenset({
    "permissions", "web_search",
})
PROJECT_PERMISSION_PREFIXES = (
    "approval_", "filesystem_", "network_", "permission_", "sandbox_",
)
GIT_BIN = Path("/usr/bin/git")
SYSTEM_UID = Path("/").stat().st_uid
GIT_ROUTING_KEYS = frozenset({
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CEILING_DIRECTORIES", "GIT_COMMON_DIR",
    "GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_NOSYSTEM",
    "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_SYSTEM", "GIT_DIR",
    "GIT_DISCOVERY_ACROSS_FILESYSTEM", "GIT_EXEC_PATH", "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NAMESPACE", "GIT_NO_REPLACE_OBJECTS", "GIT_OBJECT_DIRECTORY", "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE", "GIT_SHALLOW_FILE", "GIT_WORK_TREE",
})
USER_EXECUTABLE_ROOTS = frozenset({".local", ".nvm"})
ACTIVE_GIT_HOOKS = frozenset({
    "applypatch-msg", "commit-msg", "fsmonitor-watchman", "p4-changelist",
    "p4-post-changelist", "p4-pre-submit", "p4-prepare-changelist", "post-applypatch",
    "post-checkout", "post-commit", "post-index-change", "post-merge", "post-receive",
    "post-rewrite", "post-update", "pre-applypatch", "pre-auto-gc", "pre-commit",
    "pre-merge-commit", "pre-push", "pre-rebase", "pre-receive", "prepare-commit-msg",
    "proc-receive", "push-to-checkout", "reference-transaction", "sendemail-validate",
    "update",
})
FLEET_SCAN_MAX_REPOSITORIES = 256
FLEET_SCAN_MAX_DIRECTORIES = 32768
FLEET_SCAN_MAX_ENTRIES = 65536
EXACT_PROFILE_ARG_MAX_BYTES = 48 * 1024
EXEC_ARG_MAX_BYTES = int(os.sysconf("SC_ARG_MAX"))
EXEC_SINGLE_ARG_MAX_BYTES = int(os.sysconf("SC_PAGESIZE")) * 32
EXACT_PROFILE_TOTAL_MAX_BYTES = min(512 * 1024, EXEC_ARG_MAX_BYTES // 4)
GIT_OUTPUT_MAX_BYTES = 8 * 1024 * 1024
GIT_TIMEOUT_SECONDS = 10
PREFLIGHT_TIMEOUT_SECONDS = 30
FLEET_PRUNE = frozenset({
    ".cache", ".git", ".next", ".venv", "build", "coverage",
    "dist", "node_modules", "target", "trash", "venv",
})


def trusted_executable(path):
    """Accept an executable only below non-peer-writable root/user directories."""
    for index, item in enumerate((path, *path.parents)):
        flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
        if index > 0:
            flags |= os.O_DIRECTORY
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            fd = os.open(item, flags)
        except OSError:
            return False
        try:
            info = os.fstat(fd)
            expected_type = stat.S_ISREG(info.st_mode) if index == 0 else stat.S_ISDIR(info.st_mode)
            if (not expected_type or info.st_uid not in {SYSTEM_UID, os.getuid()}
                    or git_access.writable_by_peer(info, fd, item)):
                return False
            if index == 0 and not info.st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH):
                return False
        finally:
            os.close(fd)
    return True


def trusted_candidate(raw, boundary):
    if not raw.is_absolute() or (boundary is not None and inside(raw, boundary)):
        return None
    try:
        resolved = raw.resolve(strict=True)
    except OSError:
        return None
    home = account_home()
    if boundary is None and home is not None and inside(resolved, home):
        relative = resolved.relative_to(home)
        if not relative.parts or relative.parts[0] not in USER_EXECUTABLE_ROOTS:
            return None
    if ((boundary is not None and inside(resolved, boundary))
            or not trusted_executable(resolved)):
        return None
    return resolved


def find_node(codex_directory, boundary):
    directories = [codex_directory]
    directories.extend(
        Path(raw).expanduser() for raw in os.environ.get("PATH", "").split(os.pathsep)
        if raw and Path(raw).expanduser().is_absolute()
    )
    seen = set()
    for directory in directories:
        candidate = directory / "node"
        if candidate in seen:
            continue
        seen.add(candidate)
        resolved = trusted_candidate(candidate, boundary)
        if resolved is not None:
            return resolved
    raise RuntimeError("real Codex uses Node, but no trusted Node executable was found")


def codex_command(candidate, resolved, boundary):
    try:
        with resolved.open("rb") as source:
            prefix = source.read(128)
    except OSError as exc:
        raise RuntimeError(f"could not inspect the real Codex executable: {exc}") from exc
    if prefix.startswith(b"\x7fELF"):
        return {"program": resolved, "argv": [str(resolved)]}
    first_line = prefix.splitlines()[0] if prefix else b""
    if first_line == b"#!/usr/bin/env node":
        node = find_node(candidate.parent, boundary)
        return {"program": node, "argv": [str(node), str(resolved)]}
    raise RuntimeError(f"unsupported real Codex entry point: {first_line!r}")


def find_real_codex(cwd):
    own = Path(__file__).resolve()
    # A non-Git umbrella such as ~/projects is still project-controlled input.
    # Do not execute a Codex or Node binary found anywhere below it.
    boundary = executable_boundary(cwd)
    for raw_dir in os.environ.get("PATH", "").split(os.pathsep):
        directory = Path(raw_dir).expanduser()
        if not raw_dir or not directory.is_absolute():
            continue
        candidate = directory / "codex"
        resolved = trusted_candidate(candidate, boundary)
        if resolved is None:
            continue
        if resolved == own:
            continue
        return codex_command(candidate, resolved, boundary)
    raise RuntimeError("could not find the real Codex executable after the managed launcher")


def executable_boundary(cwd):
    boundary = project_boundary(cwd)
    if boundary is not None:
        return boundary
    raw_boundary = raw_git_boundary(cwd)
    if raw_boundary is not None:
        return raw_boundary
    # Preserve ordinary `codex` launches from the user's home: user-managed
    # Node/Codex installs normally live below it. Narrower non-Git workspaces
    # remain project-controlled boundaries (notably ~/projects).
    home = account_home()
    return None if cwd == home else cwd


def account_home():
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=True)
    except (KeyError, OSError):
        return None


def account_home_is_read_only(cwd):
    """Return true when the broad account-home workspace must not be writable."""
    return cwd == account_home()


def validated_codex_home(cwd, access, home):
    """Accept Codex config only from a trusted directory outside project input."""
    raw = os.environ.get("CODEX_HOME")
    candidate = (Path(raw).expanduser() if raw else home / ".codex")
    if not candidate.is_absolute():
        raise RuntimeError("CODEX_HOME must be an absolute trusted path")
    # Normalize dot segments without resolving names. The trusted-path walk
    # rejects symlink components, preventing a writable alias from redirecting
    # the real Codex process after validation.
    candidate = Path(os.path.abspath(candidate))
    boundary = executable_boundary(cwd)
    default_home_config = cwd == home and candidate == home / ".codex"
    if cwd == home and not default_home_config:
        raise RuntimeError(
            f"account-home launches require the default CODEX_HOME: {home / '.codex'}")
    if boundary is not None and inside(candidate, boundary) and not default_home_config:
        raise RuntimeError(f"CODEX_HOME is project-controlled: {candidate}")
    access.secure_fs.validate_trusted_path(candidate)
    open_safe_directory(access, candidate)
    return candidate


def invocation_options(args):
    value = None
    policy_override = False
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            break
        if arg in {"-C", "--cd"}:
            if index + 1 >= len(args):
                break
            value = args[index + 1]
            index += 2
            continue
        if arg == "--add-dir":
            policy_override = True
            index += 2
            continue
        if arg.startswith("-C") and len(arg) > 2:
            value = arg[2:]
        if arg.startswith("--cd="):
            value = arg.split("=", 1)[1]
        if arg in {
            "-s", "--sandbox", "-p", "--profile",
            "-a", "--ask-for-approval", "--full-auto", "--search",
            "--approve-for-me", "--not-so-yolo",
            "--dangerously-bypass-approvals-and-sandbox",
            "--ignore-user-config",
        }:
            policy_override = True
        if (arg.startswith("--add-dir=") or arg.startswith("--ask-for-approval=")
                or arg.startswith("--sandbox=") or arg.startswith("--profile=")
                or (arg.startswith("-s") and len(arg) > 2)
                or (arg.startswith("-p") and len(arg) > 2)
                or (arg.startswith("-a") and len(arg) > 2)):
            policy_override = True
        config_value = None
        if arg in {"-c", "--config"} and index + 1 < len(args):
            config_value = args[index + 1]
            index += 1
        elif arg.startswith("--config="):
            config_value = arg.split("=", 1)[1]
        elif arg.startswith("-c") and len(arg) > 2:
            config_value = arg[2:]
        if config_value is not None:
            key = config_value.split("=", 1)[0].strip()
            if key.startswith(POLICY_OVERRIDES):
                policy_override = True
        index += 1
    path = Path(value).expanduser() if value is not None else Path.cwd()
    try:
        cwd = path.resolve(strict=True)
    except OSError:
        cwd = Path.cwd().resolve()
    return {"cwd": cwd, "policyOverride": policy_override}


def scrub_git_routing(environment):
    """Remove inherited variables that can redirect or reconfigure Git."""
    clean = environment.copy()
    for key in list(clean):
        if key in GIT_ROUTING_KEYS or key.startswith(
                ("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_", "GIT_TRACE")):
            clean.pop(key, None)
    return clean


def require_preflight_time(deadline):
    """Fail before starting more work once the aggregate inspection expires."""
    if deadline is not None and time.monotonic() >= deadline:
        raise RuntimeError("aggregate Git preflight timed out")


def bounded_process(command, env, label, deadline=None):
    """Run one trusted binary while bounding combined captured output."""
    require_preflight_time(deadline)
    process = subprocess.Popen(
        command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    selected = selectors.DefaultSelector()
    buffers = {"stdout": [], "stderr": []}
    total = 0
    process_deadline = time.monotonic() + GIT_TIMEOUT_SECONDS
    deadline = process_deadline if deadline is None else min(deadline, process_deadline)
    try:
        selected.register(process.stdout, selectors.EVENT_READ, "stdout")
        selected.register(process.stderr, selectors.EVENT_READ, "stderr")
        while selected.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError(f"{label} timed out")
            events = selected.select(remaining)
            if not events:
                raise RuntimeError(f"{label} timed out")
            for key, _mask in events:
                chunk = os.read(
                    key.fileobj.fileno(),
                    min(65536, GIT_OUTPUT_MAX_BYTES - total + 1))
                if not chunk:
                    selected.unregister(key.fileobj)
                    continue
                buffers[key.data].append(chunk)
                total += len(chunk)
                if total > GIT_OUTPUT_MAX_BYTES:
                    raise RuntimeError(f"{label} output exceeded the safety limit")
        remaining = max(0, deadline - time.monotonic())
        try:
            returncode = process.wait(timeout=remaining)
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(f"{label} timed out") from exc
    except BaseException:
        process.kill()
        process.wait()
        raise
    finally:
        selected.close()
        process.stdout.close()
        process.stderr.close()
    try:
        stdout = b"".join(buffers["stdout"]).decode()
        stderr = b"".join(buffers["stderr"]).decode()
    except UnicodeDecodeError as exc:
        raise RuntimeError(f"{label} returned invalid text") from exc
    return {"returncode": returncode, "stdout": stdout, "stderr": stderr}


def git_result(cwd, *args, deadline=None):
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    return bounded_process(
        [str(GIT_BIN), "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
         "-C", str(cwd), *args], env, "Git repository lookup", deadline)


def git_output_raw(cwd, *args, deadline=None):
    result = git_result(cwd, *args, deadline=deadline)
    if result["returncode"]:
        raise RuntimeError(result["stderr"].strip() or "Git repository lookup failed")
    return result["stdout"]


def git_output(cwd, *args, deadline=None):
    return git_output_raw(cwd, *args, deadline=deadline).strip()


def open_safe_directory(access, path):
    fd, _info = access.open_owned_directory(path)
    os.close(fd)


def ensure_guard_directory(access, path):
    """Create one standard Git metadata directory without following links."""
    path = Path(path)
    parent_fd, _parent = access.open_owned_directory(path.parent)
    created = False
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent_fd)
            created = True
        except FileExistsError:
            pass
        if created:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            fd = os.open(path.name, flags, dir_fd=parent_fd)
            try:
                os.fchmod(fd, 0o700)
                access.clear_inherited_access_acl(fd, path)
                os.fsync(fd)
            finally:
                os.close(fd)
    finally:
        os.close(parent_fd)
    open_safe_directory(access, path)


def ensure_guard_file(access, path):
    """Ensure an optional protected Git metadata file exists as an owned file."""
    path = Path(path)
    existing = access.secure_read(path, missing_ok=True)
    if existing["exists"]:
        return
    if existing["parent_missing"]:
        raise RuntimeError(f"guard-file parent is missing: {path.parent}")
    parent_fd, _parent = access.open_owned_directory(path.parent)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        try:
            fd = os.open(path.name, flags, 0o600, dir_fd=parent_fd)
        except FileExistsError:
            # A same-user race is outside the threat boundary, but still
            # revalidate the result instead of trusting what appeared.
            access.secure_read(path)
            return
        try:
            os.fchmod(fd, 0o600)
            access.clear_inherited_access_acl(fd, path)
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        os.close(parent_fd)
    access.secure_read(path)


def validate_git_config_paths(config_paths, access, deadline=None):
    """Validate the repository-owned config files without changing them."""
    for path in config_paths:
        source = access.secure_read(path, missing_ok=True)
        if source["exists"]:
            reject_config_indirection(path, deadline)


def validate_trusted_config_source(path, access):
    """Validate a user- or system-owned regular Git config source."""
    access.secure_fs.validate_trusted_path(path, current_owned_leaf=False)
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        raise RuntimeError(f"effective Git config source cannot be opened safely: {path}") from exc
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode)
                or info.st_uid not in {SYSTEM_UID, os.getuid()}
                or info.st_nlink != 1
                or access.writable_by_peer(info, fd, path)):
            raise RuntimeError(f"effective Git config source is unsafe: {path}")
    finally:
        os.close(fd)


def effective_git_config_sources(
        root, source_root, access, known_paths=(), deadline=None):
    """Return project-writable effective Git config files that must be frozen.

    Includes are rejected at every scope. Git silently tolerates a missing
    include target, so protecting only currently loaded origins would leave a
    post-startup creation bypass. The effective listing also catches a global
    fsmonitor command and validates every user/system config origin Git trusted.
    """
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = bounded_process(
        [str(GIT_BIN), "-C", str(root), "config", "--includes",
         "--show-origin", "--null", "--list"],
        env, f"effective Git config validation: {root}", deadline)
    if result["returncode"]:
        raise RuntimeError(
            result["stderr"].strip() or f"could not inspect effective Git config: {root}")
    fields = result["stdout"].split("\0")
    if fields and fields[-1] == "":
        fields.pop()
    if len(fields) % 2:
        raise RuntimeError("effective Git config listing was malformed")
    protected = []
    seen_sources = set()
    known_paths = set(known_paths)
    for origin, setting in zip(fields[0::2], fields[1::2]):
        if "\n" not in setting:
            raise RuntimeError("effective Git config entry was malformed")
        key, _value = setting.split("\n", 1)
        folded = key.casefold()
        if re.fullmatch(r"include(?:if\..+)?\.path", folded):
            raise RuntimeError(
                f"effective Git config includes are incompatible with protected Git access: "
                f"{root}")
        if folded == "core.fsmonitor":
            raise RuntimeError(
                f"effective core.fsmonitor is incompatible with protected Git access: {root}")
        if not origin.startswith("file:"):
            if origin != "command line:":
                raise RuntimeError(f"unsupported effective Git config origin: {origin}")
            continue
        raw_path = Path(origin[len("file:"):]).expanduser()
        path = raw_path if raw_path.is_absolute() else root / raw_path
        path = Path(os.path.abspath(path))
        if path in seen_sources:
            continue
        seen_sources.add(path)
        validate_trusted_config_source(path, access)
        if inside(path, source_root) and path not in known_paths:
            protected.append(path)
    return protected


def validate_checkout_hooks(root, common, access, deadline=None):
    """Validate one checkout's effective hook directory and active hooks."""
    hooks = effective_hooks_path(root, common, access, deadline)
    protected = validate_active_hooks(hooks, access)
    if hooks != common / "hooks":
        protected.append(hooks)
    return protected


def materialize_git_guards(common, worktree_config_paths, access):
    """Create the standard optional paths that the runtime profile guards."""
    ensure_guard_directory(access, common / "hooks")
    ensure_guard_directory(access, common / "info")
    ensure_guard_directory(access, common / "modules")
    ensure_guard_directory(access, common / "objects")
    ensure_guard_directory(access, common / "objects" / "info")
    ensure_guard_directory(access, common / "worktrees")
    for path in (
            common / "config.worktree",
            common / "objects" / "info" / "alternates",
            common / "objects" / "info" / "http-alternates",
            *worktree_config_paths):
        ensure_guard_file(access, path)


def reject_config_indirection(path, deadline=None):
    """Reject mutable executable/config routing in one explicit config file."""
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = bounded_process(
        [str(GIT_BIN), "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
         "config", "--file", str(path), "--name-only", "--get-regexp",
         r"^(include(if\..*)?\.path|core\.fsmonitor)$"],
        env, f"local Git config validation: {path}", deadline)
    if result["returncode"] == 0:
        names = {name.casefold() for name in result["stdout"].splitlines()}
        if "core.fsmonitor" in names:
            raise RuntimeError(
                f"local core.fsmonitor is incompatible with protected Git access: {path}")
        raise RuntimeError(
            f"local Git config includes are incompatible with protected Git access: {path}")
    if result["returncode"] != 1:
        raise RuntimeError(
            result["stderr"].strip() or f"could not validate local Git config: {path}")


def effective_hooks_path(root, common, access, deadline=None):
    """Resolve the effective hooks directory after every local layer is validated."""
    env = scrub_git_routing(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = bounded_process(
        [str(GIT_BIN), "-c", "core.fsmonitor=false", "-C", str(root),
         "config", "--path", "-z", "--get", "core.hooksPath"],
        env, f"effective Git hooks lookup: {root}", deadline)
    if result["returncode"] == 1:
        return common / "hooks"
    elif result["returncode"] == 0:
        if not result["stdout"].endswith("\0") or "\0" in result["stdout"][:-1]:
            raise RuntimeError("core.hooksPath did not have one NUL-terminated value")
        raw = result["stdout"][:-1]
        if not raw:
            raise RuntimeError("core.hooksPath is empty")
        candidate = Path(raw).expanduser()
        hooks = candidate if candidate.is_absolute() else root / candidate
        # Normalize `.` and `..` without resolving symlinks. The trusted-path
        # walk below rejects every symlink component, so the configured name
        # cannot later be replaced to redirect host-side hook execution.
        hooks = Path(os.path.abspath(hooks))
    else:
        raise RuntimeError(result["stderr"].strip() or "could not resolve core.hooksPath")
    access.secure_fs.validate_trusted_path(hooks)
    open_safe_directory(access, hooks)
    return hooks


def validate_active_hooks(hooks, access):
    """Validate active hooks and return safe symlink targets to protect."""
    try:
        directory_fd, _directory = access.open_owned_directory(hooks)
    except access.Refusal as exc:
        if isinstance(exc.__cause__, FileNotFoundError):
            return []
        raise
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    protected = []
    try:
        for name in ACTIVE_GIT_HOOKS:
            try:
                entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if stat.S_ISLNK(entry.st_mode):
                if entry.st_uid != os.getuid() or entry.st_nlink != 1:
                    raise RuntimeError(
                        f"active Git hook {hooks / name} is not one protected owned link")
                try:
                    raw_target = os.readlink(name, dir_fd=directory_fd)
                except OSError as exc:
                    raise RuntimeError(
                        f"active Git hook {hooks / name} cannot be resolved safely") from exc
                candidate = Path(raw_target)
                if not candidate.is_absolute():
                    candidate = hooks / candidate
                target = Path(os.path.abspath(candidate))
                # Reject any second symlink in the target chain. The one hook
                # link itself is frozen by the surrounding hooks-directory
                # rule; its plain target receives an exact read-only overlay.
                access.secure_fs.validate_trusted_path(target)
                protected.append(target)
                open_path = target
            elif stat.S_ISREG(entry.st_mode):
                open_path = name
            else:
                raise RuntimeError(
                    f"active Git hook {hooks / name} is not one protected owned file")
            try:
                if open_path == name:
                    fd = os.open(name, flags, dir_fd=directory_fd)
                else:
                    fd = os.open(open_path, flags)
            except OSError as exc:
                raise RuntimeError(f"active Git hook {hooks / name} cannot be opened safely") from exc
            try:
                info = os.fstat(fd)
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or info.st_nlink != 1 or access.writable_by_peer(info, fd, hooks / name)):
                    raise RuntimeError(
                        f"active Git hook {hooks / name} is not one protected owned file")
            finally:
                os.close(fd)
    finally:
        os.close(directory_fd)
    return protected


def resolve_pointer(base, raw, access):
    """Resolve a Git pointer only after rejecting every lexical symlink component."""
    value = Path(raw)
    candidate = value if value.is_absolute() else base / value
    # Validate before lexical normalization: the trusted-path walker preserves
    # `..`, so `link/..` cannot erase a symlink that Git would traverse.
    access.secure_fs.validate_trusted_path(candidate)
    normalized = Path(os.path.abspath(candidate))
    access.secure_fs.validate_trusted_path(normalized)
    return normalized.resolve(strict=True)


def inspect_pointer_checkout(root, marker, access, deadline=None):
    """Return validated Git control directories for one pointer checkout."""
    access.secure_fs.validate_trusted_path(marker)
    pointer = access.secure_read(marker)
    match = re.fullmatch(r"gitdir: ([^\r\n]+)\r?\n?", pointer["text"])
    if not match:
        raise RuntimeError(f"pointer checkout has an invalid .git file: {marker}")
    git_dir = Path(git_output(
        root, "rev-parse", "--absolute-git-dir",
        deadline=deadline)).resolve(strict=True)
    common = Path(git_output(
        root, "rev-parse", "--path-format=absolute", "--git-common-dir",
        deadline=deadline)).resolve(strict=True)
    if resolve_pointer(root, match.group(1), access) != git_dir:
        raise RuntimeError(
            f"pointer checkout does not match Git's resolved directory: {marker}")
    for control in {git_dir, common}:
        access.secure_fs.validate_trusted_path(control)
        open_safe_directory(access, control)
    return {"gitDir": git_dir, "common": common}


def inspect_checkout_persistence(
        root, common, git_dir, source_root, access, deadline=None):
    """Return source-owned config and hook paths used by one checkout."""
    common_config = common / "config"
    optional_configs = list(dict.fromkeys((
        common / "config.worktree", git_dir / "config.worktree",
    )))
    access.secure_read(common_config)
    reject_config_indirection(common_config, deadline)
    validate_git_config_paths(optional_configs, access, deadline)
    protected = effective_git_config_sources(
        root, source_root, access,
        [common_config, *optional_configs], deadline)
    protected.extend(
        path for path in validate_checkout_hooks(root, common, access, deadline)
        if inside(path, source_root))
    return protected


def inside(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def raw_git_boundary(cwd):
    current = cwd
    while True:
        try:
            (current / ".git").lstat()
            if current != cwd or not sandbox_direct_git_mountpoint(cwd):
                return current
        except FileNotFoundError:
            pass
        parent = current.parent
        if parent == current:
            return None
        current = parent


def has_raw_git_marker(cwd):
    return raw_git_boundary(cwd) is not None


def sandbox_direct_git_mountpoint(cwd):
    """Recognize Codex's invalid read-only `.git` mount at a non-Git root."""
    marker = cwd / ".git"
    try:
        info = marker.lstat()
        if not stat.S_ISDIR(info.st_mode):
            return False
        allowed = {"config", "config.worktree", "hooks"}
        with os.scandir(marker) as entries:
            children = []
            for entry in entries:
                if len(children) == len(allowed):
                    return False
                children.append(entry)
        if not children:
            # An ordinary writable empty directory is project input and cannot
            # be silently classified away as a sandbox artifact. Codex's
            # synthetic mount retains the source directory's 0755 mode even
            # though the mount itself is read-only, so inspect both signals.
            return (bool(os.statvfs(marker).f_flag & os.ST_RDONLY)
                    or not info.st_mode & stat.S_IWUSR)
        # Permission rules for optional read-only Git paths can materialize
        # zero-byte placeholders. A real checkout always has HEAD, objects,
        # and refs. The older Git profile left the parent directory writable,
        # so require each exact placeholder to be its own read-only mount.
        if {entry.name for entry in children} - allowed:
            return False
        if not info.st_mode & stat.S_IWUSR:
            return True
        for entry in children:
            child = marker / entry.name
            child_info = entry.stat(follow_symlinks=False)
            if (not stat.S_ISREG(child_info.st_mode) or child_info.st_size
                    or not os.statvfs(child).f_flag & os.ST_RDONLY):
                return False
        return True
    except OSError:
        return False


def project_boundary(cwd, deadline=None):
    try:
        root = Path(git_output(
            cwd, "rev-parse", "--show-toplevel", deadline=deadline)).resolve(strict=True)
    except RuntimeError:
        require_preflight_time(deadline)
        return None
    return root if inside(cwd, root) else None


def linked_worktree(cwd, access, deadline=None):
    try:
        root = Path(git_output(
            cwd, "rev-parse", "--show-toplevel", deadline=deadline)).resolve(strict=True)
    except RuntimeError:
        require_preflight_time(deadline)
        if sandbox_direct_git_mountpoint(cwd):
            return None
        if has_raw_git_marker(cwd):
            raise
        return None
    if not inside(cwd, root):
        raise RuntimeError("Git reported a checkout that does not contain the invocation directory")
    git_dir = Path(git_output(
        cwd, "rev-parse", "--absolute-git-dir", deadline=deadline)).resolve(strict=True)
    common = Path(git_output(
        cwd, "rev-parse", "--path-format=absolute", "--git-common-dir",
        deadline=deadline)).resolve(strict=True)
    if inside(git_dir, root):
        return None

    worktrees = common / "worktrees"
    for path in (root, git_dir, common, worktrees):
        access.secure_fs.validate_trusted_path(path)
    open_safe_directory(access, root)
    open_safe_directory(access, git_dir)
    open_safe_directory(access, common)
    open_safe_directory(access, worktrees)
    if git_dir.parent != worktrees:
        raise RuntimeError("external Git directory is not a linked-worktree admin directory")

    pointer_path = root / ".git"
    pointer = access.secure_read(pointer_path)
    match = re.fullmatch(r"gitdir: ([^\r\n]+)\r?\n?", pointer["text"])
    if not match or resolve_pointer(root, match.group(1), access) != git_dir:
        raise RuntimeError("worktree .git pointer does not match Git's resolved directory")

    commondir = access.secure_read(git_dir / "commondir")["text"].strip()
    if not commondir or resolve_pointer(git_dir, commondir, access) != common:
        raise RuntimeError("worktree commondir pointer does not match Git's common directory")
    gitdir_pointer = access.secure_read(git_dir / "gitdir")["text"].strip()
    if not gitdir_pointer or resolve_pointer(
            git_dir, gitdir_pointer, access) != pointer_path:
        raise RuntimeError("worktree gitdir back-pointer does not match the checkout")

    listed = []
    for line in git_output(
            cwd, "worktree", "list", "--porcelain",
            deadline=deadline).splitlines():
        if line.startswith("worktree "):
            try:
                listed.append(Path(line[9:]).resolve(strict=True))
            except OSError:
                continue
    if root not in listed:
        raise RuntimeError("linked checkout is absent from git worktree list")
    return {"root": root, "gitDir": git_dir, "common": common, "name": git_dir.name}


def discover_ordinary_checkouts(root, access, deadline=None):
    """Find bounded descendant checkouts below a non-Git umbrella.

    Only ordinary `.git` directories are candidates. Linked worktrees and
    submodules use pointer files and need their own exact external-directory
    validation; their ordinary parent checkout is enough for fleet launches.
    Return both outputs together so callers cannot omit the pointer guards.
    """
    queue = deque([root])
    found = []
    protected_paths = []
    directories_seen = 0
    entries_seen = 0
    while queue:
        require_preflight_time(deadline)
        directory = queue.popleft()
        directories_seen += 1
        if directories_seen > FLEET_SCAN_MAX_DIRECTORIES:
            raise RuntimeError(
                f"child scan exceeded {FLEET_SCAN_MAX_DIRECTORIES} directories below {root}")
        marker = directory / ".git"
        try:
            marker_info = marker.lstat()
        except FileNotFoundError:
            marker_info = None
        except OSError as exc:
            raise RuntimeError(f"cannot inspect {marker}: {exc}") from exc
        if marker_info is not None:
            if stat.S_ISDIR(marker_info.st_mode):
                # Codex's sandbox may leave an empty `.git` mountpoint at a
                # non-Git workspace root. Only stop descending when Git itself
                # confirms this directory is the checkout root.
                if sandbox_direct_git_mountpoint(directory):
                    protected_paths.append(marker)
                    reported = None
                else:
                    try:
                        reported = Path(git_output(
                            directory, "rev-parse", "--show-toplevel",
                            deadline=deadline)).resolve(strict=True)
                    except RuntimeError as exc:
                        raise RuntimeError(
                            f"existing Git marker cannot be validated: {marker}: {exc}") from exc
                    if reported != directory:
                        raise RuntimeError(
                            f"existing Git marker does not identify its checkout: {marker}")
                    protected_paths.append(marker)
                    found.append(directory)
                    if len(found) > FLEET_SCAN_MAX_REPOSITORIES:
                        raise RuntimeError(
                            f"child scan exceeded {FLEET_SCAN_MAX_REPOSITORIES} "
                            f"repositories below {root}")
                    # Keep scanning the checkout: opening this root makes its
                    # source writable, so nested submodule/worktree pointer
                    # files must be added to the exact read-only rules.
            elif stat.S_ISREG(marker_info.st_mode):
                # A valid pointer-file checkout is a submodule or linked
                # worktree, not an ordinary child root for this fleet path.
                try:
                    reported = Path(git_output(
                        directory, "rev-parse", "--show-toplevel",
                        deadline=deadline)).resolve(strict=True)
                except RuntimeError as exc:
                    raise RuntimeError(
                        f"existing Git pointer cannot be validated: {marker}: {exc}") from exc
                if reported != directory:
                    raise RuntimeError(
                        f"existing Git pointer does not identify its checkout: {marker}")
                protected_paths.append(marker)
                controls = inspect_pointer_checkout(
                    directory, marker, access, deadline)
                for control in controls.values():
                    if inside(control, root):
                        protected_paths.append(control)
                protected_paths.extend(inspect_checkout_persistence(
                    directory, controls["common"], controls["gitDir"],
                    root, access, deadline))
                # Keep scanning pointer-file checkouts too. A submodule or
                # linked worktree can itself contain nested pointer files,
                # all of which sit below writable source roots.
            else:
                raise RuntimeError(f"Git marker has an unsafe type: {marker}")
        children = []
        try:
            with os.scandir(directory) as entries:
                for entry in entries:
                    require_preflight_time(deadline)
                    if not entry.is_dir(follow_symlinks=False):
                        continue
                    if directory.name == ".workspaces" and entry.name != "worktrees":
                        continue
                    entries_seen += 1
                    if entries_seen > FLEET_SCAN_MAX_ENTRIES:
                        raise RuntimeError(
                            f"child scan exceeded {FLEET_SCAN_MAX_ENTRIES} "
                            f"directory entries below {root}")
                    if entry.name in FLEET_PRUNE:
                        continue
                    children.append(Path(entry.path))
        except OSError as exc:
            raise RuntimeError(f"child scan cannot inspect {directory}: {exc}") from exc
        for child in sorted(children):
            queue.append(child)
    return {"roots": found, "protectedPaths": protected_paths}


def discover_submodule_paths(root, common, access, deadline=None):
    """Return initialized gitlink markers and their validated Git directories."""
    queue = deque([root])
    protected = []
    seen = set()
    submodules_seen = 0
    while queue:
        require_preflight_time(deadline)
        checkout = queue.popleft()
        if checkout in seen:
            continue
        seen.add(checkout)
        output = git_output_raw(
            checkout, "ls-files", "--stage", "-z", deadline=deadline)
        for record in output.split("\0"):
            if not record or "\t" not in record:
                continue
            header, raw_path = record.split("\t", 1)
            if header.split(" ", 1)[0] != "160000":
                continue
            submodules_seen += 1
            if submodules_seen > FLEET_SCAN_MAX_REPOSITORIES:
                raise RuntimeError("submodule count exceeded the safety limit")
            candidate = checkout / raw_path
            try:
                submodule = candidate.resolve(strict=True)
            except FileNotFoundError:
                # An uninitialized submodule has no source directory or marker.
                continue
            if not inside(submodule, root):
                raise RuntimeError(f"submodule path escapes its checkout: {candidate}")
            marker = submodule / ".git"
            try:
                info = marker.lstat()
            except FileNotFoundError:
                continue
            if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
                raise RuntimeError(f"submodule marker has an unsafe type: {marker}")
            protected.append(marker)
            if stat.S_ISREG(info.st_mode):
                controls = inspect_pointer_checkout(
                    submodule, marker, access, deadline)
                protected.extend(inspect_checkout_persistence(
                    submodule, controls["common"], controls["gitDir"],
                    root, access, deadline))
                git_dir = controls["gitDir"]
                if inside(git_dir, root):
                    protected.append(git_dir)
                elif not inside(git_dir, common / "modules"):
                    raise RuntimeError(
                        f"submodule Git directory escapes the checkout and common modules: "
                        f"{git_dir}")
            else:
                access.secure_fs.validate_trusted_path(marker)
                open_safe_directory(access, marker)
            queue.append(submodule)
    return protected


def ordinary_checkout(root, access, deadline=None):
    """Validate that a discovered marker is one ordinary checkout root."""
    reported = Path(git_output(
        root, "rev-parse", "--show-toplevel", deadline=deadline)).resolve(strict=True)
    git_dir = Path(git_output(
        root, "rev-parse", "--absolute-git-dir", deadline=deadline)).resolve(strict=True)
    common = Path(git_output(
        root, "rev-parse", "--path-format=absolute", "--git-common-dir",
        deadline=deadline)).resolve(strict=True)
    marker = root / ".git"
    marker_info = marker.lstat()
    if not stat.S_ISDIR(marker_info.st_mode):
        raise RuntimeError("ordinary checkout .git marker is not a real directory")
    expected = marker.resolve(strict=True)
    if reported != root or git_dir != expected or common != expected:
        raise RuntimeError("marker is not an ordinary checkout rooted at the discovered directory")
    access.secure_fs.validate_trusted_path(root)
    access.secure_fs.validate_trusted_path(expected)
    open_safe_directory(access, root)
    open_safe_directory(access, expected)
    return {"root": root}


def shared_worktree_plan(
        root, expected_common, access, source_root,
        global_policy, base_active=None, deadline=None):
    """Return validated sibling policy, config, and control-path facts."""
    output = git_output(
        root, "worktree", "list", "--porcelain", "-z", deadline=deadline)
    worktree_roots = []
    protected_paths = []
    for field in output.split("\0"):
        if not field.startswith("worktree "):
            continue
        raw_path = field[len("worktree "):]
        try:
            worktree_root = Path(raw_path).resolve(strict=True)
        except OSError as exc:
            raise RuntimeError(f"cannot validate shared worktree {raw_path}: {exc}") from exc
        if worktree_root == root:
            continue
        worktree_roots.append(worktree_root)
        marker = worktree_root / ".git"
        try:
            marker_info = marker.lstat()
        except OSError:
            marker_info = None
        if (marker_info is not None and stat.S_ISREG(marker_info.st_mode)
                and inside(worktree_root, source_root)):
            access.secure_read(marker)
            protected_paths.append(marker)

    allowed = True
    offline_worktrees = []
    worktree_configs = []
    for worktree_root in worktree_roots:
        require_preflight_time(deadline)
        context = linked_worktree(worktree_root, access, deadline)
        if context is None:
            context = ordinary_checkout(worktree_root, access, deadline)
            context["common"] = (worktree_root / ".git").resolve(strict=True)
        else:
            worktree_configs.append(context["gitDir"] / "config.worktree")
        if context["common"] != expected_common:
            raise RuntimeError(
                f"shared worktree does not resolve to the expected common Git directory: "
                f"{worktree_root}")
        protected_paths.extend(inspect_checkout_persistence(
            worktree_root, expected_common,
            context.get("gitDir", expected_common), source_root, access, deadline))
        permission = permission_plan(
            context, worktree_root, access, base_active=base_active,
            global_policy=global_policy)
        active = permission["active"]
        protected_paths.extend(
            path for path in permission["protectedPaths"] if inside(path, source_root))
        child_online = active in {"git-workspace", "no-git"}
        if not child_online:
            offline_worktrees.append(worktree_root)
        if active not in {"git-workspace", "git-workspace-offline"}:
            print(
                f"codex-worktree: shared Git augmentation disabled for {root}: "
                f"linked worktree opts out at {worktree_root}", file=sys.stderr)
            allowed = False
    return {
        "allowed": allowed,
        "offlineWorktrees": tuple(offline_worktrees),
        "protectedPaths": tuple(protected_paths),
        "worktreeConfigPaths": tuple(worktree_configs),
    }


def checkout_plan(
        context, cwd, access, global_policy, source_root,
        base_active=None, deadline=None):
    """Inspect one checkout completely without changing repository state."""
    root = context["root"]
    common = context.get("common") or (root / ".git").resolve(strict=True)
    worktree_configs = []
    protected = []
    if "gitDir" in context:
        protected.append(root / ".git")
        worktree_configs.append(context["gitDir"] / "config.worktree")
    protected.extend(inspect_checkout_persistence(
        root, common, context.get("gitDir", common),
        source_root, access, deadline))
    permission = permission_plan(
        context, cwd, access, base_active=base_active,
        global_policy=global_policy)
    shared = shared_worktree_plan(
        root, common, access, source_root, global_policy,
        base_active=base_active, deadline=deadline)
    worktree_configs.extend(shared["worktreeConfigPaths"])
    protected.extend(permission["protectedPaths"])
    protected.extend(shared["protectedPaths"])
    protected.extend(discover_submodule_paths(
        root, common, access, deadline))
    return {
        "active": permission["active"],
        "common": common,
        "offlineWorktrees": shared["offlineWorktrees"],
        "protectedPaths": tuple(protected),
        "sharedGitAllowed": shared["allowed"],
        "worktreeConfigPaths": tuple(worktree_configs),
    }


def exact_profile_args(name, description, parent, rules):
    """Emit a chain of bounded inline profiles below Linux's per-arg cap."""
    normalized = sorted(set((str(path), mode) for path, mode in rules))
    chunks = []
    current = []
    for rule in normalized:
        candidate = [*current, rule]
        index = len(chunks)
        profile_name = f"{name}-{index}"
        profile_parent = parent if index == 0 else f"{name}-{index - 1}"
        argument = exact_profile_argument(
            profile_name, description, profile_parent, candidate)
        if len(argument.encode()) <= EXACT_PROFILE_ARG_MAX_BYTES:
            current = candidate
            continue
        if not current:
            raise RuntimeError(f"one filesystem rule exceeds the runtime profile argument budget")
        chunks.append(current)
        current = [rule]
    if current:
        chunks.append(current)

    arguments = []
    for index, chunk in enumerate(chunks):
        profile_name = f"{name}-{index}"
        profile_parent = parent if index == 0 else f"{name}-{index - 1}"
        argument = exact_profile_argument(profile_name, description, profile_parent, chunk)
        if len(argument.encode()) > EXACT_PROFILE_ARG_MAX_BYTES:
            raise RuntimeError("runtime profile argument budget was exceeded")
        arguments.extend(("-c", argument))
    final_name = f"{name}-{len(chunks) - 1}"
    arguments.extend(("-c", f"default_permissions={toml_string(final_name)}"))
    if argument_bytes(arguments) > EXACT_PROFILE_TOTAL_MAX_BYTES:
        raise RuntimeError("aggregate runtime profile argument budget was exceeded")
    return arguments


def argument_bytes(arguments):
    """Approximate execve string storage, including each terminating NUL."""
    return sum(len(os.fsencode(argument)) + 1 for argument in arguments)


def ensure_exec_budget(arguments, environment):
    """Leave headroom for Linux's argv/env pointer table and exec bookkeeping."""
    environment_entries = [f"{key}={value}" for key, value in environment.items()]
    if any(len(os.fsencode(value)) + 1 >= EXEC_SINGLE_ARG_MAX_BYTES
           for value in [*arguments, *environment_entries]):
        raise RuntimeError("one exec argument or environment entry exceeded the kernel safety limit")
    pointer_bytes = (len(arguments) + len(environment) + 2) * 8
    environment_bytes = argument_bytes(environment_entries)
    payload = argument_bytes(arguments) + environment_bytes + pointer_bytes
    reserve = min(64 * 1024, EXEC_ARG_MAX_BYTES // 4)
    if payload > EXEC_ARG_MAX_BYTES - reserve:
        raise RuntimeError("aggregate exec argument budget was exceeded")


def exact_profile_argument(name, description, parent, rules):
    rule_text = ",".join(
        f"{toml_string(path)}={toml_string(mode)}" for path, mode in rules)
    profile = (
        f"{{description={toml_string(description)},extends={toml_string(parent)},"
        f"filesystem={{{rule_text}}}}}"
    )
    return f"permissions.{name}={profile}"


def render_checkout_launch(context, plan):
    """Turn one immutable checkout inspection into one immutable launch plan."""
    root = context["root"]
    active = plan["active"]
    protected = plan["protectedPaths"]
    git_enabled = active in {"git-workspace", "git-workspace-offline"}
    shared_allowed = plan["sharedGitAllowed"]
    if active in {"git-workspace", "no-git"} and plan["offlineWorktrees"]:
        print(
            f"codex-worktree: shared Git augmentation disabled for {root}: offline "
            f"policy at {plan['offlineWorktrees'][0]} requires a direct project "
            "launch; network access is session-wide", file=sys.stderr)
        shared_allowed = False
    if not git_enabled or not shared_allowed:
        fallback = "no-git" if active == "git-workspace" else "no-git-offline"
        parent = active if not git_enabled else fallback
        return {
            "arguments": profile_with_exact_reads(parent, protected),
            "guardContexts": (),
        }
    if "gitDir" in context:
        arguments = runtime_profile(context, active)
        if protected:
            arguments.extend(exact_profile_args(
                FLEET_RUNTIME_PROFILE,
                "Effective Git persistence paths are read-only.",
                RUNTIME_PROFILE,
                [(path, "read") for path in protected]))
    else:
        # The installed profile records Git intent but deliberately has no
        # workspace-relative `.git` write. Use the same exact, validated rules
        # as fleet launches so a non-repository workspace can never acquire a
        # synthetic `.git` mount target from the static profile.
        arguments = fleet_runtime_profile([root], protected, active)
    return {
        "arguments": arguments,
        "guardContexts": ((plan["common"], plan["worktreeConfigPaths"]),),
    }


def normal_checkout_plan(root, cwd, access, deadline=None):
    """Protect local policy, nested Git, hooks, and sibling worktree controls."""
    context = ordinary_checkout(root, access, deadline)
    global_policy = load_global_permission(access)
    plan = checkout_plan(
        context, cwd, access, global_policy, root, deadline=deadline)
    return render_checkout_launch(context, plan)


def fleet_runtime_profile(roots, protected_paths, active):
    if active not in git_access.MANAGED_CHOICES:
        return []
    online = active in {"git-workspace", "no-git"}
    parent = "no-git" if online else "no-git-offline"
    enabled_markers = {root / ".git" for root in roots}
    read_only_paths = set(protected_paths) - enabled_markers
    if not roots and not read_only_paths:
        # A non-Git umbrella is itself a workspace root. Do not apply the
        # relative Git profile there when no eligible child needs exact access.
        fallback = active if active in {"no-git", "no-git-offline"} else parent
        return ["-c", f"default_permissions={toml_string(fallback)}"]
    rules = [(path, "read") for path in read_only_paths]
    for root in roots:
        git_dir = root / ".git"
        rules.extend((
            (git_dir, "write"),
            (git_dir / "config", "read"),
            (git_dir / "config.worktree", "read"),
            (git_dir / "hooks", "read"),
            (git_dir / "modules", "read"),
            (git_dir / "objects" / "info" / "alternates", "read"),
            (git_dir / "objects" / "info" / "http-alternates", "read"),
            (git_dir / "worktrees", "read"),
        ))
    return exact_profile_args(
        FLEET_RUNTIME_PROFILE,
        "Exact fleet Git access with persistence paths read-only.", parent, rules)


def pinned_profile(active):
    if active in git_access.MANAGED_CHOICES:
        return ["-c", f"default_permissions={toml_string(active)}"]
    return []


def profile_with_exact_reads(parent, paths):
    if not paths:
        return pinned_profile(parent)
    return exact_profile_args(
        FLEET_RUNTIME_PROFILE,
        "Effective Git persistence paths are read-only.", parent,
        [(path, "read") for path in paths])


def fleet_workspace_plan(cwd, access, deadline=None):
    """Make eligible child repos effective roots for a non-Git umbrella."""
    arguments = []
    access.secure_fs.validate_trusted_path(cwd)
    open_safe_directory(access, cwd)
    global_policy = load_global_permission(access)
    umbrella = permission_plan(
        {"root": cwd}, cwd, access, global_policy=global_policy)
    umbrella_active = umbrella["active"]
    protected_paths = list(umbrella["protectedPaths"])
    umbrella_online = umbrella_active in {"git-workspace", "no-git"}
    fleet_online = umbrella_online
    offline_roots = []
    discovery = discover_ordinary_checkouts(cwd, access, deadline)
    roots = []
    protected_paths.extend(discovery["protectedPaths"])
    guard_contexts = []
    for root in discovery["roots"]:
        require_preflight_time(deadline)
        context = ordinary_checkout(root, access, deadline)
        plan = checkout_plan(
            context, root, access, global_policy, cwd,
            base_active=umbrella_active, deadline=deadline)
        active = plan["active"]
        child_online = active in {"git-workspace", "no-git"}
        git_enabled = active in {"git-workspace", "git-workspace-offline"}
        protected_paths.extend(plan["protectedPaths"])
        if not child_online:
            fleet_online = False
            offline_roots.append(root)
        if plan["offlineWorktrees"]:
            fleet_online = False
            offline_roots.extend(plan["offlineWorktrees"])
        if not git_enabled:
            print(
                f"codex-worktree: child Git augmentation disabled by local policy: {root}",
                file=sys.stderr)
            continue
        if not plan["sharedGitAllowed"]:
            continue
        roots.append(root)
        guard_contexts.append((plan["common"], plan["worktreeConfigPaths"]))
    fleet_active = umbrella_active
    if umbrella_online and not fleet_online:
        fleet_active = (
            "git-workspace-offline" if umbrella_active == "git-workspace"
            else "no-git-offline")
        print(
            f"codex-worktree: fleet network disabled by offline policy at "
            f"{offline_roots[0]}", file=sys.stderr)
    profile = fleet_runtime_profile(roots, protected_paths, fleet_active)
    for root in roots:
        arguments.extend(("--add-dir", str(root)))
    arguments.extend(profile)
    return {
        "arguments": arguments,
        "guardContexts": tuple(guard_contexts),
    }


def materialize_launch_guards(contexts, access):
    """Commit a fully inspected launch plan after its exec payload is safe."""
    for common, worktree_config_paths in contexts:
        materialize_git_guards(common, worktree_config_paths, access)


def config_layers(root, cwd):
    yield root / ".codex" / "config.toml"
    try:
        relative = cwd.relative_to(root)
    except ValueError:
        return
    cursor = root
    for part in relative.parts:
        cursor = cursor / part
        yield cursor / ".codex" / "config.toml"


def load_global_permission(access):
    source = access.secure_read(access.codex_home() / "config.toml")
    parsed = access.parse_toml(source["text"], source["path"])
    global_active = access.validate_managed_profiles(parsed, source["path"])
    reject_reserved_runtime_profiles(parsed, source["path"])
    return global_active


def permission_plan(context, cwd, access, base_active=None, global_policy=None):
    """Return the effective choice together with every policy source it trusts."""
    global_active = (
        global_policy if global_policy is not None else load_global_permission(access))
    active = global_active if base_active is None else base_active
    protected_paths = []
    for path in config_layers(context["root"], cwd):
        local_source = access.secure_read(path, missing_ok=True)
        if not local_source["exists"]:
            continue
        # secure_read pins and validates the immediate parent and file. The
        # full walk additionally rejects a peer-writable intermediate project
        # directory that could swap the policy subtree between launches.
        access.secure_fs.validate_trusted_path(path)
        protected_paths.append(path)
        local = access.parse_toml(local_source["text"], path)
        forbidden = sorted(
            key for key in local
            if key in PROJECT_PERMISSION_KEYS
            or key.startswith(PROJECT_PERMISSION_PREFIXES))
        if forbidden:
            raise RuntimeError(
                f"{path}: project permission keys prevent Git augmentation: {forbidden}")
        choice = local.get("default_permissions")
        if choice is not None:
            if not isinstance(choice, str) or choice not in access.MANAGED_CHOICES:
                raise RuntimeError(f"{path}: unrelated permission profile {choice!r}")
            active_git = active in {"git-workspace", "git-workspace-offline"}
            active_network = active in {"git-workspace", "no-git"}
            chosen_git = choice in {"git-workspace", "git-workspace-offline"}
            chosen_network = choice in {"git-workspace", "no-git"}
            if chosen_git and not active_git:
                raise RuntimeError(f"{path}: local policy cannot re-enable Git access")
            if chosen_network and not active_network:
                raise RuntimeError(f"{path}: local policy cannot re-enable network access")
            active = choice
    return {"active": active, "protectedPaths": tuple(protected_paths)}


def reject_reserved_runtime_profiles(parsed, path):
    for name in parsed.get("permissions", {}):
        if any(name == reserved or name.startswith(f"{reserved}-")
               for reserved in RESERVED_RUNTIME_PROFILES):
            raise RuntimeError(f"{path}: reserved runtime profile name is already defined")


def toml_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def runtime_profile(context, active):
    if active == "git-workspace":
        parent = "no-git"
    elif active == "git-workspace-offline":
        parent = "no-git-offline"
    else:
        return None
    common = str(context["common"])
    admin = f"worktrees/{context['name']}"
    rules = [
        (".", "read"),
        ("objects", "write"),
        ("objects/info/alternates", "read"),
        ("objects/info/http-alternates", "read"),
        ("refs", "write"),
        ("logs/refs", "write"),
        ("FETCH_HEAD", "write"),
        ("FETCH_HEAD.lock", "write"),
        ("packed-refs", "write"),
        ("packed-refs.lock", "write"),
        ("packed-refs.new", "write"),
        (admin, "write"),
        (f"{admin}/commondir", "read"),
        (f"{admin}/gitdir", "read"),
        (f"{admin}/config.worktree", "read"),
        ("config", "read"),
        ("config.worktree", "read"),
        ("hooks", "read"),
        ("info", "read"),
        ("HEAD", "read"),
        ("index", "read"),
        ("logs/HEAD", "read"),
        ("worktrees", "read"),
    ]
    rule_text = ",".join(f"{toml_string(path)}={toml_string(mode)}" for path, mode in rules)
    profile = (
        "{description=\"Validated linked-worktree Git metadata access.\","
        f"extends={toml_string(parent)},"
        f"filesystem={{{toml_string(common)}={{{rule_text}}}}}}}"
    )
    return [
        "--add-dir", common,
        "-c", f"permissions.{RUNTIME_PROFILE}={profile}",
        "-c", f"default_permissions={toml_string(RUNTIME_PROFILE)}",
    ]


def main():
    args = sys.argv[1:]
    invocation = invocation_options(args)
    access = git_access
    try:
        home = account_home()
        if home is None:
            raise RuntimeError("could not resolve the account home directory")
        # Project-selected account/config roots could redirect both the real
        # Codex process and Git's global configuration lookup.
        os.environ["HOME"] = str(home)
        os.environ.pop("XDG_CONFIG_HOME", None)
        os.environ["CODEX_HOME"] = str(
            validated_codex_home(invocation["cwd"], access, home))
    except (RuntimeError, access.Refusal, OSError) as exc:
        print(f"codex-worktree: unsafe configuration environment: {exc}", file=sys.stderr)
        raise SystemExit(2)
    try:
        real = find_real_codex(invocation["cwd"])
    except RuntimeError as exc:
        print(f"codex-worktree: {exc}", file=sys.stderr)
        raise SystemExit(127)
    launch_plan = {"arguments": [], "guardContexts": ()}
    if not invocation["policyOverride"]:
        try:
            cwd = invocation["cwd"]
            deadline = time.monotonic() + PREFLIGHT_TIMEOUT_SECONDS
            if account_home_is_read_only(cwd):
                launch_plan = {
                    "arguments": ["--sandbox", "read-only"],
                    "guardContexts": (),
                }
            else:
                context = linked_worktree(cwd, access, deadline)
                if context is not None:
                    global_policy = load_global_permission(access)
                    plan = checkout_plan(
                        context, cwd, access, global_policy,
                        context["root"], deadline=deadline)
                    launch_plan = render_checkout_launch(context, plan)
                else:
                    boundary = project_boundary(cwd, deadline)
                    if boundary is not None:
                        launch_plan = normal_checkout_plan(
                            boundary, cwd, access, deadline)
                    else:
                        launch_plan = fleet_workspace_plan(cwd, access, deadline)
        except (RuntimeError, access.Refusal, OSError) as exc:
            # A non-Git umbrella is itself one recursively writable workspace.
            # If discovery or policy validation is incomplete, a relative
            # `.git` guard cannot protect unknown descendants. Make the whole
            # session read-only instead of granting partial fleet coverage.
            launch_plan = {
                "arguments": ["--sandbox", "read-only"],
                "guardContexts": (),
            }
            print(f"codex-worktree: Git augmentation failed closed: {exc}", file=sys.stderr)
    environment = scrub_git_routing(os.environ)
    for key in ("NODE_OPTIONS", "NODE_PATH"):
        environment.pop(key, None)
    launch_arguments = [*real["argv"], *launch_plan["arguments"], *args]
    try:
        ensure_exec_budget(launch_arguments, environment)
        materialize_launch_guards(launch_plan["guardContexts"], access)
    except (RuntimeError, access.Refusal, OSError) as exc:
        launch_plan = {
            "arguments": ["--sandbox", "read-only"],
            "guardContexts": (),
        }
        launch_arguments = [*real["argv"], *launch_plan["arguments"], *args]
        print(f"codex-worktree: Git augmentation failed closed: {exc}", file=sys.stderr)
        try:
            ensure_exec_budget(launch_arguments, environment)
        except RuntimeError as fallback_exc:
            print(f"codex-worktree: launch payload is unsafe: {fallback_exc}", file=sys.stderr)
            raise SystemExit(2)
    os.execve(
        real["program"], launch_arguments, environment)


if __name__ == "__main__":
    main()
